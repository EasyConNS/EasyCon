# 嵌套 FOR：ForStep 快速路径（尾部融合）双端对拍——外层 body 不读外层循环变量
# （历史死循环形态）、三层嵌套、零迭代、单次、部分路径读、出循环 $i==upper
$total = 0
FOR $i = 1 TO 3
    FOR $j = 1 TO 3
        $total = $total + 1
    NEXT
NEXT
PRINT $total
$acc = 0
FOR $i = 1 TO 2
    FOR $j = 1 TO 2
        FOR $k = 1 TO 2
            $acc = $acc + $i + $j
        NEXT
    NEXT
NEXT
PRINT $acc
$zero = 0
FOR $i = 3 TO 1
    $zero = $zero + 1
NEXT
PRINT $zero
$once = 0
FOR $i = 5 TO 5
    $once = $once + 1
NEXT
PRINT $once
$partial = 0
FOR $i = 1 TO 4
    IF $i == 2
        $partial = $partial + 100
    ENDIF
    $partial = $partial + 1
NEXT
PRINT $partial
$last = 0
FOR $i = 1 TO 5
    $last = $i
NEXT
PRINT $last
$skip = 0
FOR $i = 1 TO 5
    IF $i == 3
        CONTINUE
    ENDIF
    $skip = $skip + 1
NEXT
PRINT $skip
$brk = 0
FOR $i = 1 TO 5
    IF $i == 3
        BREAK
    ENDIF
    $brk = $brk + 1
NEXT
PRINT $brk
