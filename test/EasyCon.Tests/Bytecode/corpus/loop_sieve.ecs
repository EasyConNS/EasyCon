# 循环嵌套语义锁：FOR（ForStep 快速路径）内嵌 WHILE + IF（全局提升 φ + 合并点）——
# 锁「SCCP 可执行边 × φ 臂对齐」不被 CFG 简化破坏（trampoline 折叠 9999 回归实证）
$count = 0
FOR $n = 2 TO 100
    $is_prime = 1
    $d = 2
    WHILE $d * $d <= $n
        IF $n % $d == 0
            $is_prime = 0
        ENDIF
        $d = $d + 1
    END
    $count = $count + $is_prime
NEXT
PRINT $count
$total = 0
FOR $i = 1 TO 3
    FOR $j = 1 TO 3
        $total = $total + $i * $j
    NEXT
NEXT
PRINT $total
