# 查表：文本命中英文名或别名行 "/名称" 返回图鉴编号（1-151），未命中 0
FUNC LOOKUP($t:STRING):INT
    $j = 0
    $r = 0
    WHILE $j < 151
        $name = $P_EN[$j]
        IF $r == 0
            IF $t == $name
                $r = $j + 1
            ENDIF
            IF $t == "/" & $name
                $r = $j + 1
            ENDIF
        ENDIF
        $j = $j + 1
    END
    RETURN $r
ENDFUNC

# 图鉴编号 → 中文名（main 不可见 lib 全局，经此函数取）
FUNC DEX_NAME($dex:INT):STRING
    RETURN $P_ZH[$dex - 1]
ENDFUNC
