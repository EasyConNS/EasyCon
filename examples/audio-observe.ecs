# AUDIO_SCORE 返回 0～100 的整数峰值，百分制向下取整。
# 桌面 GUI：保存脚本、连接游戏音频，标签放在脚本旁
# audiolabel/医疗.audiolabel/{label.json,audio.wav}。无需手柄。
AUDIO_LOAD "医疗"
PRINT "开始识别，请在接下来的 8 秒内触发目标声音"
WAIT 8000
$score = AUDIO_SCORE("医疗")
PRINT "本轮已完成分析的最高分：" & $score
IF $score >= 85
    PRINT "达到示例阈值"
ELSE
    PRINT "尚未达到示例阈值"
ENDIF
AUDIO_UNLOAD "医疗"