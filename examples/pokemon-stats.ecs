# ============================================================
# 宝可梦状态页识别（名称 + 能力值计算）（std 配方 PP_OCR_TEXT / PP_OCR_DIGITS，固定 ROI）
# 布局基准：1920x1080 火红/叶绿英文状态页（见 demo 截图 ppocr2/3.png）
# 模型：__APP__/models/ppocr/PP-OCRv6_medium_rec.onnx（外部资产，换模型改这里）
# 字典：__APP__/models/ppocr/ppocrv6_dict.txt（名称识别经 NET_LABELS 标签表层）
# 数字窗口：_DIGITS_BASE = '0' 的 class 下标，随模型代际指定（std 不钉常数）——
#       PP-OCRv6 字典 33（数字在表头）；PP-OCRv5 旧资产为 16163（数字在表尾）
# 原理：rec 输出 [1,T,C]，数字行走 CTC_FOLD 打洞折叠（数字子集窗口）；
#       名称行走 PP_OCR_TEXT 整字典折叠（NET_ARGMAX × NET_LABEL 逐帧解码）。
#       自定义解码策略可在脚本侧经 NET_ROWS/NET_ARGMAX 逐帧遍历实现。
# ============================================================

_DIGITS_BASE = 33

# ---- 主流程 ----
$net = NET_LOAD(__APP__ + "/models/ppocr/PP-OCRv6_medium_rec.onnx")
IF $net > 0
    $dict = __APP__ + "/models/ppocr/ppocrv6_dict.txt"

    # 同帧共享采集：整帧只采一次，各区域坐标相对该帧（省 6 次采集 + base64 编解码）
    $frame = FRAME()

    # 宝可梦名称（标签表层整字典识别，配方 PP_OCR_TEXT；
    # 名称区 = 主行 (190,130,1530,85) 去掉左侧 Lv 段与右侧 HP 段）
    $name = PP_OCR_TEXT($net, $frame, 400, 130, 690, 85, $dict)
    PRINT "NAME: " & $name

    # 主行：Lv50 XXX HP65/65（整行数字混排，仅作展示）
    $hp = PP_OCR_DIGITS($net, $frame, _DIGITS_BASE, 190, 130, 1530, 85)
    PRINT "HP row: " & $hp

    # 右列能力值行（标签 + 数字整行，配方只解析数字）；
    # INT() 数值化吞掉模型伪影的前导零——具体游戏策略归脚本（SPEED 行模型吐 028）
    $atk = INT(PP_OCR_DIGITS($net, $frame, _DIGITS_BASE, 990, 262, 730, 74))
    $def = INT(PP_OCR_DIGITS($net, $frame, _DIGITS_BASE, 990, 344, 730, 72))
    $spa = INT(PP_OCR_DIGITS($net, $frame, _DIGITS_BASE, 990, 426, 730, 74))
    $spd = INT(PP_OCR_DIGITS($net, $frame, _DIGITS_BASE, 990, 508, 730, 74))
    $spe = INT(PP_OCR_DIGITS($net, $frame, _DIGITS_BASE, 990, 592, 730, 78))

    PRINT "ATTACK: " & $atk
    PRINT "DEFENSE: " & $def
    PRINT "SP.ATK: " & $spa
    PRINT "SP.DEF: " & $spd
    PRINT "SPEED: " & $spe

    # 计算能力值总和（不含 HP）
    $sum = $atk + $def + $spa + $spd + $spe
    PRINT "STAT SUM: " & $sum

    # 经验行（HP EXP.POINTS 19531）
    $exp = PP_OCR_DIGITS($net, $frame, _DIGITS_BASE, 355, 680, 1370, 85)
    PRINT "EXP POINTS: " & $exp

    NET_UNLOAD $net
    PRINT "done"
ELSE
    PRINT "NET_LOAD failed (check models/ppocr/)"
ENDIF
