# ============================================================
# 宝可梦状态页识别 + 能力值计算（std 配方 PP_OCR_DIGITS，固定 ROI）
# 布局基准：1920x1080 火红/叶绿英文状态页（见 demo 截图 ppocr2/3.png）
# 模型：__APP__/models/ppocr/PP-OCRv5_mobile_rec.onnx（外部资产）
# 原理：rec 输出 [1,T,C]，std CTC_FOLD 打洞折叠（去重 + blank 重置 + 数字子集）；
#       自定义解码策略可在脚本侧经 NET_ROWS/NET_ARGMAX 逐帧遍历实现。
# ============================================================

# ---- 主流程 ----
$net = NET_LOAD(__APP__ + "/models/ppocr/PP-OCRv5_mobile_rec.onnx")
IF $net > 0
    # 主行：Lv50 XXX HP65/65（整行数字混排，仅作展示）
    $hp = PP_OCR_DIGITS($net, 190, 130, 1530, 85)
    PRINT "HP row: " & $hp

    # 右列能力值行（标签 + 数字整行，配方只解析数字）；
    # INT() 数值化吞掉模型伪影的前导零——具体游戏策略归脚本（SPEED 行模型吐 028）
    $atk = INT(PP_OCR_DIGITS($net, 990, 262, 730, 74))
    $def = INT(PP_OCR_DIGITS($net, 990, 344, 730, 72))
    $spa = INT(PP_OCR_DIGITS($net, 990, 426, 730, 74))
    $spd = INT(PP_OCR_DIGITS($net, 990, 508, 730, 74))
    $spe = INT(PP_OCR_DIGITS($net, 990, 592, 730, 78))

    PRINT "ATTACK: " & $atk
    PRINT "DEFENSE: " & $def
    PRINT "SP.ATK: " & $spa
    PRINT "SP.DEF: " & $spd
    PRINT "SPEED: " & $spe

    # 计算能力值总和（不含 HP）
    $sum = $atk + $def + $spa + $spd + $spe
    PRINT "STAT SUM: " & $sum

    # 经验行（HP EXP.POINTS 19531）
    $exp = PP_OCR_DIGITS($net, 355, 680, 1370, 85)
    PRINT "EXP POINTS: " & $exp

    NET_UNLOAD $net
    PRINT "done"
ELSE
    PRINT "NET_LOAD failed (check models/ppocr/)"
ENDIF
