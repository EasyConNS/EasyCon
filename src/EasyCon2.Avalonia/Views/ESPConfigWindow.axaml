<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EasyCon2.Avalonia.ViewModels"
        xmlns:conv="using:EasyCon2.Avalonia.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="EasyCon2.Avalonia.Views.ESPConfigWindow"
        x:DataType="vm:ESPConfigViewModel"
        Title="手柄设置"
        Width="650"
        SizeToContent="Height"
        MinWidth="550"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:ByteEqualConverter x:Key="ByteEqualConverter" />
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" Spacing="12">

            <!-- 手柄模式 + 外观颜色 水平并排 -->
            <Border BorderBrush="{DynamicResource ThemeBorderFillColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="24">

                    <!-- 左: 手柄模式 -->
                    <StackPanel Grid.Column="0" Spacing="10">
                        <TextBlock Text="🎮 手柄模式"
                                   FontSize="15" FontWeight="SemiBold"/>

                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton Content="Pro"
                                         IsChecked="{Binding SelectedMode, Converter={StaticResource ByteEqualConverter}, ConverterParameter=3}" />
                            <RadioButton Content="JoyCon-R"
                                         IsChecked="{Binding SelectedMode, Converter={StaticResource ByteEqualConverter}, ConverterParameter=2}" />
                            <RadioButton Content="JoyCon-L"
                                         IsChecked="{Binding SelectedMode, Converter={StaticResource ByteEqualConverter}, ConverterParameter=1}" />
                        </StackPanel>

                        <Button Content="修改模式"
                                Command="{Binding SetModeCommand}"
                                HorizontalAlignment="Right"
                                Padding="16,6" />
                    </StackPanel>

                    <!-- 右: 外观颜色 -->
                    <StackPanel Grid.Column="1" Spacing="10">
                        <TextBlock Text="🎨 外观颜色"
                                   FontSize="15" FontWeight="SemiBold"/>

                        <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto"
                              ColumnSpacing="16" RowSpacing="8">

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="机身" VerticalAlignment="Center" Width="45"/>
                                <Button Command="{Binding PickBodyColorCommand}" Padding="0">
                                    <Border Width="50" Height="24" CornerRadius="4"
                                            Background="{Binding BodyColor}"/>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="按钮" VerticalAlignment="Center" Width="45"/>
                                <Button Command="{Binding PickButtonColorCommand}" Padding="0">
                                    <Border Width="50" Height="24" CornerRadius="4"
                                            Background="{Binding ButtonColor}"/>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="左握把" VerticalAlignment="Center" Width="45"/>
                                <Button Command="{Binding PickGripLColorCommand}" Padding="0">
                                    <Border Width="50" Height="24" CornerRadius="4"
                                            Background="{Binding GripLColor}"/>
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="右握把" VerticalAlignment="Center" Width="45"/>
                                <Button Command="{Binding PickGripRColorCommand}" Padding="0">
                                    <Border Width="50" Height="24" CornerRadius="4"
                                            Background="{Binding GripRColor}"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Button Content="修改颜色"
                                Command="{Binding SetColorCommand}"
                                HorizontalAlignment="Right"
                                Padding="16,6" />
                    </StackPanel>

                </Grid>
            </Border>

            <!-- Amiibo -->
            <Border BorderBrush="{DynamicResource ThemeBorderFillColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">

                    <TextBlock Grid.Row="0" Text="🏷️ Amiibo"
                               FontSize="15" FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <!-- 左侧表单 -->
                    <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,16,0">

                        <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <!-- 存储序号 -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="存储序号"
                                       VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding SaveIndexList}"
                                      SelectedIndex="{Binding SelectedSaveIndex}"
                                      PlaceholderText="选择序号" />

                            <!-- 游戏 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="游戏"
                                       VerticalAlignment="Center" Margin="0,6,0,0"/>
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      ItemsSource="{Binding GameList}"
                                      SelectedItem="{Binding SelectedGame}"
                                      PlaceholderText="选择游戏"
                                      Margin="0,6,0,0" />

                            <!-- Amiibo -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="存储内容"
                                       VerticalAlignment="Center" Margin="0,6,0,0"/>
                            <ComboBox Grid.Row="2" Grid.Column="1"
                                      ItemsSource="{Binding AmiiboList}"
                                      SelectedItem="{Binding SelectedAmiibo}"
                                      DisplayMemberBinding="{Binding Name}"
                                      PlaceholderText="先选择游戏"
                                      IsEnabled="{Binding HasAmiiboItems}"
                                      Margin="0,6,0,0" />

                            <!-- 卡名 -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="卡名"
                                       VerticalAlignment="Center" Margin="0,6,0,0"/>
                            <TextBox Grid.Row="3" Grid.Column="1"
                                     Text="{Binding AmiiboNickname}"
                                     Margin="0,6,0,0" />

                            <!-- 用户名 -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="用户名"
                                       VerticalAlignment="Center" Margin="0,6,0,0"/>
                            <TextBox Grid.Row="4" Grid.Column="1"
                                     Text="{Binding Username}"
                                     Margin="0,6,0,0" />

                            <!-- 当前序号 -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="当前序号"
                                       VerticalAlignment="Center" Margin="0,6,0,0"/>
                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                <NumericUpDown Value="{Binding CurrentAmiiboIndex}"
                                               Minimum="0" Maximum="19"
                                               Width="120"/>
                                <Button Content="激活"
                                        Command="{Binding ActivateAmiiboCommand}"
                                        Padding="12,4" />
                            </StackPanel>

                            <!-- 提示 -->
                            <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                                       Text="自定义Amiibo：将bin文件(540字节)放入程序目录下Amiibo文件夹"
                                       FontSize="12"
                                       Foreground="{DynamicResource ThemeTextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </Grid>

                        <Button Content="保存Amiibo"
                                Command="{Binding SaveAmiiboCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="8,6" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- 右侧图片预览 -->
                    <Border Grid.Row="1" Grid.Column="1"
                            Width="160" Height="180"
                            BorderBrush="{DynamicResource ThemeBorderFillColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Background="{DynamicResource ThemeBackgroundBrush}">
                        <Panel>
                            <Image Source="{Binding AmiiboPreviewImage}"
                                   Stretch="Uniform"
                                   Margin="4"/>
                            <TextBlock Text="Amiibo预览"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource ThemeTextFillColorTertiaryBrush}" />
                        </Panel>
                    </Border>

                </Grid>
            </Border>

            <!-- 底部状态栏 -->
            <Border BorderBrush="{DynamicResource ThemeBorderFillColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,6">
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="13" />
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
