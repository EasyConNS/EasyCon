<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EasyCon2.Avalonia.ViewModels"
             x:Class="EasyCon2.Avalonia.Views.Shared.UserConfigPage"
             x:DataType="vm:MainWindowViewModel"
             x:Name="root">
    <ScrollViewer Classes="settings-scroll"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  MinWidth="340">
        <StackPanel Classes="settings-page">
            <Border Classes="settings-card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="card-title"
                               Text="关于"/>
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Text="{Binding CurrentVersion}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <Button Classes="tool-button card-action"
                                Grid.Column="1"
                                Command="{Binding CheckUpdateCommand}"
                                IsEnabled="{Binding !IsCheckingUpdate}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="12" Height="12"
                                         Stroke="{DynamicResource SystemAccentColor}"
                                         StrokeThickness="2"
                                         StrokeDashArray="2.5,1.5"
                                         IsVisible="{Binding IsCheckingUpdate}">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Styles>
                                        <Style Selector="Ellipse">
                                            <Style.Animations>
                                                <Animation Duration="0:0:0.8"
                                                           IterationCount="Infinite">
                                                    <KeyFrame Cue="0%">
                                                        <Setter Property="(RotateTransform.Angle)" Value="0"/>
                                                    </KeyFrame>
                                                    <KeyFrame Cue="100%">
                                                        <Setter Property="(RotateTransform.Angle)" Value="360"/>
                                                    </KeyFrame>
                                                </Animation>
                                            </Style.Animations>
                                        </Style>
                                    </Ellipse.Styles>
                                </Ellipse>
                                <TextBlock Text="{Binding CheckUpdateButtonText}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="tool-button card-action"
                                Grid.Column="2"
                                Command="{Binding OpenGitHubCommand}"
                                ToolTip.Tip="在浏览器中打开 GitHub">
                            <Path Data="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.416 22 12c0-5.523-4.477-10-10-10z"
                                  Width="14" Height="14"
                                  Fill="{DynamicResource SystemAccentColor}"
                                  Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="settings-card">
                <StackPanel Spacing="14">
                    <TextBlock Classes="card-title"
                               Text="配置"/>

                    <Grid Classes="settings-row"
                          ColumnDefinitions="110,*,Auto">
                        <TextBlock Text="采集卡类型"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding CaptureTypeOptions}"
                                  SelectedItem="{Binding SelectedCaptureType}"
                                  HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="2"
                                Classes="tool-button"
                                Content="设置环境变量"
                                Margin="8,0,0,0"/>
                    </Grid>

                    <Grid Classes="settings-row"
                          ColumnDefinitions="*,Auto">
                        <TextBlock Text="推送设置"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Classes="tool-button"
                                Content="打开配置"
                                Command="{Binding OpenAlertConfigCommand}"/>
                    </Grid>

                    <Grid Classes="settings-row"
                          ColumnDefinitions="*,Auto">
                        <TextBlock Text="代码自动补全"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1"
                                      OnContent=""
                                      OffContent=""
                                      IsChecked="{Binding IsAutoCompletionEnabled}"/>
                    </Grid>

                    <Grid Classes="settings-row"
                          ColumnDefinitions="*,Auto">
                        <TextBlock Text="显示代码折叠"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1"
                                      OnContent=""
                                      OffContent=""
                                      IsChecked="{Binding ShowFolding}"/>
                    </Grid>

                    <Grid Classes="settings-row"
                          ColumnDefinitions="*,Auto">
                        <TextBlock Text="高精度模式"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1"
                                      OnContent=""
                                      OffContent=""
                                      IsChecked="{Binding IsHighResolutionTimingEnabled}"/>
                    </Grid>

                </StackPanel>
            </Border>

            <Border Classes="settings-card">
                <StackPanel Spacing="14">
                    <TextBlock Classes="card-title"
                               Text="外观样式"/>

                    <Grid Classes="settings-row"
                          ColumnDefinitions="110,*,Auto">
                        <TextBlock Text="欢迎词"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding WelcomeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="欢迎使用 easycon"
                                 HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="2"
                                Classes="tool-button"
                                Content="重置"
                                Command="{Binding ResetWelcomeTextCommand}"
                                Margin="8,0,0,0"/>
                    </Grid>

                    <TextBlock Classes="setting-caption"
                               Text="风格"/>
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Classes="theme-option"
                                Command="{Binding SelectThemeStyleCommand}"
                                CommandParameter="默认">
                            <Border Classes="theme-preview classic">
                                <StackPanel Spacing="8">
                                    <Border Classes="theme-strip"/>
                                    <TextBlock Text="默认"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Button>
                        <Button Grid.Column="1"
                                Classes="theme-option"
                                Command="{Binding SelectThemeStyleCommand}"
                                CommandParameter="卡片">
                            <Border Classes="theme-preview rounded">
                                <StackPanel Spacing="8">
                                    <Border Classes="theme-strip"/>
                                    <TextBlock Text="卡片"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Button>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="10">
                        <TextBlock Classes="setting-caption" Text="外观"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Classes="setting-caption"
                                   Text="跟随系统自动切换"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="2"
                                      Classes="compact-switch"
                                      OnContent=""
                                      OffContent=""
                                      IsChecked="{Binding AutoSwitchColorSchemeEnabled}"
                                      VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*"
                          ColumnSpacing="10"
                          IsEnabled="{Binding IsManualColorSchemeEnabled}">
                        <Button Grid.Column="0"
                                Classes="theme-option"
                                Command="{Binding SelectColorSchemeCommand}"
                                CommandParameter="浅色">
                            <Border Classes="theme-preview white">
                                <StackPanel Spacing="8">
                                    <Border Classes="theme-strip"/>
                                    <TextBlock Text="浅色"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Button>
                        <Button Grid.Column="1"
                                Classes="theme-option"
                                Command="{Binding SelectColorSchemeCommand}"
                                CommandParameter="暖色">
                            <Border Classes="theme-preview light">
                                <StackPanel Spacing="8">
                                    <Border Classes="theme-strip"/>
                                    <TextBlock Text="暖色"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Button>
                        <Button Grid.Column="2"
                                Classes="theme-option"
                                Command="{Binding SelectColorSchemeCommand}"
                                CommandParameter="深色">
                            <Border Classes="theme-preview dark">
                                <StackPanel Spacing="8">
                                    <Border Classes="theme-strip"/>
                                    <TextBlock Text="深色"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Button>
                    </Grid>

                    <Border Classes="inline-config-panel">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="10">
                                <TextBlock Text="窗口栏"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="视运行状态自动切换布局"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <ToggleSwitch Grid.Column="2"
                                              OnContent=""
                                              OffContent=""
                                              IsChecked="{Binding AutoSwitchLayoutEnabled}"/>
                            </Grid>

                            <StackPanel IsEnabled="{Binding AutoSwitchLayoutEnabled}"
                                        Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="自定义布局区域"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Classes="tool-button"
                                            Content="恢复默认"
                                            Command="{Binding RestoreDefaultLayoutCommand}"/>
                                </Grid>

                                <TextBlock Classes="setting-caption"
                                           Text="未运行时预览"/>
                                <Grid ColumnDefinitions="*,*"
                                      ColumnSpacing="10">
                                    <RadioButton Classes="layout-option"
                                                 GroupName="{Binding IdleLayoutGroupName, ElementName=root}"
                                                 IsChecked="{Binding IsIdleThreeColumnLayoutSelected}">
                                        <Border Classes="layout-preview">
                                            <Grid ColumnDefinitions="0.7*,1.9*,0.8*"
                                                  ColumnSpacing="4">
                                                <Border Classes="layout-cell tree-cell">
                                                    <TextBlock Text="工作树"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Grid.Column="1"
                                                        Classes="layout-cell editor-cell">
                                                    <TextBlock Text="编辑区"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <Grid Grid.Column="2"
                                                      RowDefinitions="*,*"
                                                      RowSpacing="4">
                                                    <Border Classes="layout-cell video-cell">
                                                        <TextBlock Text="视频源"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Border Grid.Row="1"
                                                            Classes="layout-cell output-cell">
                                                        <TextBlock Text="输出区"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </RadioButton>

                                    <RadioButton Grid.Column="1"
                                                 Classes="layout-option"
                                                 GroupName="{Binding IdleLayoutGroupName, ElementName=root}"
                                                 IsChecked="{Binding IsIdleTwoColumnLayoutSelected}">
                                        <Border Classes="layout-preview">
                                            <Grid ColumnDefinitions="0.7*,2.6*"
                                                  ColumnSpacing="4">
                                                <Border Classes="layout-cell tree-cell">
                                                    <TextBlock Text="工作树"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Grid.Column="1"
                                                        Classes="layout-cell editor-cell">
                                                    <TextBlock Text="编辑区"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </RadioButton>
                                </Grid>

                                <TextBlock Classes="setting-caption"
                                           Text="运行时预览"/>
                                <Grid ColumnDefinitions="*,*,*"
                                      ColumnSpacing="10">
                                    <RadioButton Classes="layout-option"
                                                 GroupName="{Binding RunningLayoutGroupName, ElementName=root}"
                                                 IsChecked="{Binding IsRunningThreeColumnLayoutSelected}">
                                        <Border Classes="layout-preview">
                                            <Grid ColumnDefinitions="0.7*,1.9*,0.8*"
                                                  ColumnSpacing="4">
                                                <Border Classes="layout-cell tree-cell">
                                                    <TextBlock Text="工作树"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Grid.Column="1"
                                                        Classes="layout-cell editor-cell">
                                                    <TextBlock Text="编辑区"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <Grid Grid.Column="2"
                                                      RowDefinitions="*,*"
                                                      RowSpacing="4">
                                                    <Border Classes="layout-cell video-cell">
                                                        <TextBlock Text="视频源"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Border Grid.Row="1"
                                                            Classes="layout-cell output-cell">
                                                        <TextBlock Text="输出区"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </RadioButton>

                                    <RadioButton Grid.Column="1"
                                                 Classes="layout-option"
                                                 GroupName="{Binding RunningLayoutGroupName, ElementName=root}"
                                                 IsChecked="{Binding IsRunningTwoColumnLayoutSelected}">
                                        <Border Classes="layout-preview">
                                            <Grid ColumnDefinitions="*,*"
                                                  ColumnSpacing="4">
                                                <Border Classes="layout-cell video-cell">
                                                    <TextBlock Text="视频源"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <Border Grid.Column="1"
                                                        Classes="layout-cell output-cell">
                                                    <TextBlock Text="输出区"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </RadioButton>

                                    <RadioButton Grid.Column="2"
                                                 Classes="layout-option"
                                                 GroupName="{Binding RunningLayoutGroupName, ElementName=root}"
                                                 IsChecked="{Binding IsRunningOneColumnLayoutSelected}">
                                        <Border Classes="layout-preview">
                                            <Border Classes="layout-cell output-cell">
                                                <TextBlock Text="输出区"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Border>
                                    </RadioButton>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
