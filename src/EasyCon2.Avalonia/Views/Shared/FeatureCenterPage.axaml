<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:EasyCon2.Avalonia.Markup"
             xmlns:vm="using:EasyCon2.Avalonia.ViewModels"
             x:Class="EasyCon2.Avalonia.Views.Shared.FeatureCenterPage"
             x:DataType="vm:MainWindowViewModel">
    <ScrollViewer Classes="settings-scroll"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  MinWidth="340">
        <StackPanel Classes="settings-page">
            <Border Classes="settings-card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="card-title"
                               Text="{loc:Translate Text.Feature.RemoteRun}"/>
                    <Grid Classes="feature-row"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="10">
                        <Button Content="{loc:Translate Text.Feature.RemoteRun}"
                                Command="{Binding Switch.RemoteRunCommand}"
                                HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="1"
                                Content="{loc:Translate Text.Feature.RemoteStop}"
                                Command="{Binding Switch.RemoteStopCommand}"
                                HorizontalAlignment="Stretch"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="settings-card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="card-title"
                               Text="{loc:Translate Text.Feature.CompileFlash}"/>
                    <Grid Classes="feature-row"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="10">
                        <Button Content="{loc:Translate Text.Feature.CompileFlash}"
                                Command="{Binding Firmware.CompileFlashCommand}"
                                HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="1"
                                Content="{loc:Translate Text.Feature.ClearFlash}"
                                Command="{Binding Firmware.ClearFlashCommand}"
                                HorizontalAlignment="Stretch"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="settings-card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="card-title"
                               Text="{loc:Translate Text.Feature.Firmware}"/>
                    <Grid Classes="feature-row"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="10">
                        <ComboBox ItemsSource="{Binding Firmware.FirmwareOptions}"
                                  SelectedItem="{Binding Firmware.SelectedFirmware}"
                                  HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="1"
                                Content="{loc:Translate Text.Feature.Generate}"
                                Command="{Binding Firmware.GenerateFirmwareCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="settings-card">
                <Grid Classes="feature-row"
                      ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="card-title"
                                   Text="{loc:Translate Text.Feature.ControllerBt}"/>
                        <TextBlock Classes="setting-caption"
                                   Text="{loc:Translate Text.Feature.ESPConfig}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="配置"
                            Command="{Binding OpenESPConfigCommand}"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Classes="settings-card dark-disabled-buttons disabled-feature-card"
                    IsEnabled="False"
                    Opacity="0.5">
                <StackPanel Spacing="12">
                    <TextBlock Classes="card-title"
                               Text="{loc:Translate Text.Feature.Drawing}"/>
                    <Grid Classes="feature-row"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="10">
                        <Button Content="喷射战士"
                                HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="1"
                                Content="自由画板"
                                HorizontalAlignment="Stretch"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
