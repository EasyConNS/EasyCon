<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:qq="using:EasyCon2.Avalonia.Core.QQ"
             x:Class="EasyCon2.Avalonia.Views.QQNotificationControl"
             x:DataType="qq:QQNotificationViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchDangerBrush}"/>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="*,Auto">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,24,24,14" Spacing="14">
                <TextBlock Text="脚本 ALERT 会在后台发送文字，并默认附带当前视频画面；无视频画面时发送 EasyCon Logo。" TextWrapping="Wrap" Opacity="0.72"/>

                <TextBlock Text="AppID"/>
                <TextBox Text="{Binding AppId, Mode=TwoWay}" Watermark="QQ 开放平台 AppID" IsEnabled="{Binding CanEdit}"/>
                <TextBlock Text="AppSecret"/>
                <TextBox Text="{Binding Secret, Mode=TwoWay}" PasswordChar="●" Watermark="仅保存在当前会话，或使用记住密钥" IsEnabled="{Binding CanEdit}"/>
                <CheckBox Content="记住 AppSecret（Windows DPAPI 加密）"
                          IsChecked="{Binding RememberSecret, Mode=TwoWay}" IsEnabled="{Binding CanRememberSecret}"/>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="验证凭据" Command="{Binding VerifyCommand}"/>
                    <TextBlock Text="{Binding VerificationDisplay}" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Padding="12" BorderThickness="1" CornerRadius="6"
                        BorderBrush="{DynamicResource WorkbenchGroupBorderBrush}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="私聊接收方" FontWeight="SemiBold"/>
                        <TextBlock Text="绑定时向机器人私聊当前验证码。" Opacity="0.7" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding UserOpenIdDisplay}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="绑定私聊" Command="{Binding BindUserCommand}"/>
                            <CheckBox Content="启用私聊" IsChecked="{Binding UserEnabled, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="12" BorderThickness="1" CornerRadius="6"
                        BorderBrush="{DynamicResource WorkbenchGroupBorderBrush}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="群聊接收方" FontWeight="SemiBold"/>
                        <TextBlock Text="先把机器人加入目标群，再在群里 @机器人发送当前验证码。" Opacity="0.7" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding GroupOpenIdDisplay}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="绑定群聊" Command="{Binding BindGroupCommand}"/>
                            <CheckBox Content="启用群聊" IsChecked="{Binding GroupEnabled, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <CheckBox Content="通知默认附带当前视频画面"
                          IsChecked="{Binding AttachImage, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"/>
                <CheckBox Content="启用自动 QQ 通知"
                          IsChecked="{Binding Enabled, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Margin="24,0,24,24" Spacing="14">
            <Border Padding="12" Background="{DynamicResource WorkbenchOutlineAccentBackgroundBrush}" CornerRadius="6"
                    IsVisible="{Binding HasBindingCode}">
                <StackPanel Spacing="5">
                    <TextBlock Text="当前绑定码"/>
                    <TextBlock Text="{Binding BindingCode}" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding BindingCountdownDisplay}"/>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding Feedback}" Classes.error="{Binding FeedbackIsError}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="取消操作" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}"/>
                <Button Content="发送图文测试" Command="{Binding SendTestCommand}"/>
                <Button Content="保存" Command="{Binding SaveCommand}" IsDefault="True"/>
                <Button Content="关闭" IsCancel="True" Click="OnClose"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
