<Window xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:vm="using:EasyCon2.Avalonia.ViewModels"
         xmlns:conv="using:EasyCon2.Avalonia.Converters"
         xmlns:behaviors="using:EasyCon2.Avalonia.Behaviors"
         xmlns:controls="using:EasyCon2.Avalonia.Controls"
         xmlns:editor="using:EasyCon2.Avalonia.Core.Editor"
         xmlns:tag="using:EasyCon2.Avalonia.Core.TagEditor"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         mc:Ignorable="d"
         d:DesignWidth="1200"
         d:DesignHeight="800"
 x:Class="EasyCon2.Avalonia.Views.MainWindow"
          x:DataType="vm:MainWindowViewModel"
          Icon="/Assets/favicon.ico"
          Title="{Binding WindowTitle}"
          Width="1200"
          Height="800"
          MinWidth="800"
          MinHeight="600"
          behaviors:FileDropBehavior.Command="{Binding DropFileCommand}">

    <Window.Resources>
        <conv:BoolToGreenBrushConverter x:Key="BoolToGreenBrush" />
        <conv:BoolToRunColorConverter x:Key="BoolToRunColor" />
    </Window.Resources>

    <Grid RowDefinitions="*,Auto">

        <!-- 上部主操作区：三列布局 -->
        <Grid Grid.Row="0" ColumnDefinitions="220,*,5,300">

            <!-- 第一列：文件层级侧边栏 -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource ThemeBorderFillColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <ContentControl Content="{Binding FileTreeView}" />
            </Border>

            <!-- 第二列：标签切换（文本编辑器 / 标签编辑器） -->
            <Border Grid.Column="1">
                <TabControl SelectedIndex="{Binding SelectedEditorTab}">
                    <TabItem Header="文本编辑">
                        <Grid RowDefinitions="Auto,*">
                            <!-- 脚本路径栏 -->
                            <Border Grid.Row="0"
                                    Padding="8,4"
                                    BorderBrush="{DynamicResource ThemeBorderFillColorDefaultBrush}"
                                    BorderThickness="0,0,0,1">
                                <TextBlock Text="{Binding ScriptDisplayPath}"
                                           FontSize="12"
                                           Opacity="0.6"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <!-- 编辑器始终显示 -->
                            <editor:ScriptEditorControl x:Name="ScriptEditor" Grid.Row="1"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="标签编辑">
                        <tag:TagEditorView x:Name="TagEditor" DataContext="{Binding TagEditorViewModel}"/>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- 第二列与第三列之间的拖拽分割线 -->
            <GridSplitter Grid.Column="2"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource ThemeBorderFillColorDefaultBrush}"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- 第三列：监视器（上） + 日志（下） -->
            <Grid Grid.Column="3" RowDefinitions="*,*">

                <!-- 第三列上半部分：监视器 -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource ThemeBorderFillColorDefaultBrush}"
                        BorderThickness="0,0,0,1"
                        PointerEntered="MonitorArea_PointerEntered"
                        PointerExited="MonitorArea_PointerExited">
                    <Grid>
                        <ContentControl Content="{Binding MonitorView}" />
                        <!-- 暂停按钮覆盖层 -->
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="8"
                                IsVisible="{Binding IsMonitorToolbarVisible}"
                                Background="{DynamicResource ThemeControlFillColorDefaultBrush}"
                                Padding="5"
                                CornerRadius="4">
                            <Button Content="{Binding MonitorPauseButtonText}"
                                    Command="{Binding ToggleMonitorPauseCommand}"
                                    Padding="10,5"
                                    HorizontalContentAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 第三列下半部分：日志输出 -->
                <Grid Grid.Row="1">
                    <TextBox Text="{Binding LogOutput}"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="NoWrap"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            FontFamily="Consolas, Microsoft YaHei"
                            FontSize="13"
                            Padding="10"
                            behaviors:AutoScrollBehavior.IsEnabled="True"
                            PointerEntered="LogBox_PointerEntered"
                            PointerExited="LogBox_PointerExited"/>
                    <!-- 工具条覆盖层 -->
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="10"
                            IsVisible="{Binding IsLogToolbarVisible}"
                            Background="{DynamicResource ThemeControlFillColorDefaultBrush}"
                            Padding="5"
                            PointerEntered="LogBox_PointerEntered"
                            PointerExited="LogBox_PointerExited">
                        <Button Content="清屏"
                               Command="{Binding ClearLogCommand}"
                               Padding="10,5"
                               HorizontalContentAlignment="Center"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- 下部模块操作区：保持不变 -->
        <Border Grid.Row="1"
               Padding="10"
               BorderBrush="{DynamicResource ThemeBorderFillColorDefaultBrush}"
               BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,*,*,*,*"
                 HorizontalAlignment="Stretch">

                <!-- 第一个模块连接器：单片机 -->
                <Border Grid.Column="0"
                       BorderBrush="{DynamicResource ThemeBorderFillColorDefaultBrush}"
                       BorderThickness="1"
                       Margin="5"
                       Padding="10">
                    <StackPanel Orientation="Vertical" Spacing="10">
                        <ComboBox ItemsSource="{Binding SerialPortOptions}"
                                  SelectedItem="{Binding SelectedSerialPort}"
                                  HorizontalAlignment="Stretch"
                                  behaviors:DropDownRefreshBehavior.RefreshCommand="{Binding RefreshSerialPortsCommand}"/>
                        <Grid ColumnDefinitions="*,*">
                            <Button Grid.Column="0"
                                    Content="{Binding NintendoSwitchButtonText}"
                                    Command="{Binding ConnectNintendoSwitchCommand}"
                                    IsEnabled="{Binding !IsConnectingNintendoSwitch}"
                                    Margin="0,0,5,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="自动连接"
                                    Command="{Binding AutoConnectNintendoSwitchCommand}"
                                    IsEnabled="{Binding !IsConnectingNintendoSwitch}"
                                    Margin="5,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding NintendoSwitchStatus}"
                                  HorizontalAlignment="Center"
                                  FontWeight="Bold"
                                  Foreground="{Binding IsNintendoSwitchConnected, Converter={StaticResource BoolToGreenBrush}}"/>
                    </StackPanel>
                </Border>

                <!-- 第二个模块连接器：视频源 -->
                <Border Grid.Column="1"
                       BorderBrush="{DynamicResource ThemeBorderFillColorDefaultBrush}"
                       BorderThickness="1"
                       Margin="5"
                       Padding="10">
                    <StackPanel Orientation="Vertical" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding CaptureSourceOptions}"
                                      SelectedItem="{Binding SelectedCaptureSource}"
                                      HorizontalAlignment="Stretch"
                                      behaviors:DropDownRefreshBehavior.RefreshCommand="{Binding RefreshCaptureSourcesCommand}"/>
                            <Button Grid.Column="1"
                                    Content="监视器"
                                    Command="{Binding ShowMonitorCommand}"
                                    Margin="5,0,0,0"
                                    Padding="8,4"
                                    VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Button Grid.Column="0"
                                    Content="{Binding CaptureSourceButtonText}"
                                    Command="{Binding ConnectCaptureSourceCommand}"
                                    IsEnabled="{Binding !IsConnectingCaptureSource}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="编辑标签"
                                    Command="{Binding OpenTagEditorCommand}"
                                    Margin="5,0,0,0"
                                    Padding="8,4"
                                    VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding CaptureSourceStatus}"
                                  HorizontalAlignment="Center"
                                  FontWeight="Bold"
                                  Foreground="{Binding IsCaptureSourceConnected, Converter={StaticResource BoolToGreenBrush}}"/>
                    </StackPanel>
                </Border>

                <!-- 第三个模块连接器：手柄 -->
                <Border Grid.Column="2"
                       BorderBrush="{DynamicResource ThemeBorderFillColorDefaultBrush}"
                       BorderThickness="1"
                       Margin="5"
                       Padding="10">
                    <StackPanel Orientation="Vertical" Spacing="10">
                        <ComboBox ItemsSource="{Binding ControlSourceOptions}"
                                  SelectedItem="{Binding SelectedControlSource}"
                                  HorizontalAlignment="Stretch"
                                  behaviors:DropDownRefreshBehavior.RefreshCommand="{Binding RefreshControlSourcesCommand}"/>
                        <Grid ColumnDefinitions="*,*">
                            <Button Grid.Column="0"
                                    Content="{Binding ControllerButtonText}"
                                    Command="{Binding ConnectControllerCommand}"
                                    IsEnabled="{Binding !IsConnectingController}"
                                    Margin="0,0,5,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="修改按键映射"
                                    Command="{Binding EditKeyMappingCommand}"
                                    CommandParameter="{Binding $parent[Window]}"
                                    IsEnabled="{Binding IsEditKeyMappingEnabled}"
                                    Margin="5,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding ControlSourceStatus}"
                                  HorizontalAlignment="Center"
                                  FontWeight="Bold"
                                  Foreground="{Binding IsControllerConnected, Converter={StaticResource BoolToGreenBrush}}"/>
                    </StackPanel>
                </Border>

                <!-- 脚本录制模块 -->
                <Border Grid.Column="3"
                       BorderBrush="{DynamicResource ThemeBorderFillColorDefaultBrush}"
                       BorderThickness="1"
                       Margin="5"
                       Padding="10">
                    <StackPanel Orientation="Vertical" Spacing="10">
                        <TextBlock Text="脚本录制"
                                  HorizontalAlignment="Center"
                                  FontWeight="Bold"/>
                        <Button Content="录制脚本"
                                Command="{Binding StartRecordCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                        <Button Content="停止录制"
                                Command="{Binding StopRecordCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 运行脚本按钮 -->
                <Border Grid.Column="4"
                       Margin="5"
                       Padding="10">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Spacing="10">
                        <TextBlock Text="{Binding RunTimeDisplay}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   FontFamily="Consolas"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <Button Content="{Binding RunButtonText}"
                                Command="{Binding RunScriptCommand}"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="White"
                                Background="{Binding IsRunning, Converter={StaticResource BoolToRunColor}}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
