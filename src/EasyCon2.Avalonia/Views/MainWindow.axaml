<Window xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:vm="using:EasyCon2.Avalonia.ViewModels"
         xmlns:behaviors="using:EasyCon2.Avalonia.Behaviors"
         xmlns:controls="using:EasyCon2.Avalonia.Controls"
         xmlns:editor="using:EasyCon2.Avalonia.Core.Editor"
         xmlns:tag="using:EasyCon2.Avalonia.Core.TagEditor"
         xmlns:agent="using:EasyCon2.Avalonia.Core.AiAgent"
         xmlns:terminal="using:EasyCon2.Avalonia.Core.Terminal"
         xmlns:views="using:EasyCon2.Avalonia.Views"
         xmlns:chrome="using:Avalonia.Controls.Chrome"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         mc:Ignorable="d"
         d:DesignWidth="1200"
         d:DesignHeight="800"
 x:Class="EasyCon2.Avalonia.Views.MainWindow"
          x:DataType="vm:MainWindowViewModel"
          Icon="/Assets/favicon.ico"
          Title="{Binding WindowTitle}"
           Width="1200"
           Height="800"
           MinWidth="800"
           MinHeight="600"
           WindowDecorations="None"
           CanResize="True"
           ExtendClientAreaToDecorationsHint="True"
           ExtendClientAreaTitleBarHeightHint="34"
           Background="{DynamicResource WorkbenchWindowBrush}"
           behaviors:FileDropBehavior.Command="{Binding DropFileCommand}">

    <Window.Styles>
        <Style Selector="ToggleButton.debug-switch">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="16" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Width="30"
                           Height="16">
                        <Border x:Name="SwitchTrack"
                                Width="30"
                                Height="16"
                                CornerRadius="8"
                                Background="{DynamicResource WorkbenchInputBrush}"
                                BorderBrush="{DynamicResource WorkbenchMutedTextBrush}"
                                BorderThickness="1"/>
                        <Border x:Name="SwitchThumb"
                                Width="10"
                                Height="10"
                                Margin="4,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                CornerRadius="5"
                                Background="{DynamicResource WorkbenchLogTextBrush}"/>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.debug-switch:checked /template/ Border#SwitchTrack">
            <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchMutedTextBrush}" />
        </Style>
        <Style Selector="ToggleButton.debug-switch:checked /template/ Border#SwitchThumb">
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>
        <Style Selector="Button.editor-toolbar-button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchMutedTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.editor-toolbar-button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WorkbenchButtonHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchControlBorderBrush}" />
        </Style>

        <Style Selector="Button.window-caption-button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.window-caption-button /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Button.window-caption-button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WorkbenchButtonHoverBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Button.window-caption-button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WorkbenchButtonHoverBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- 限制用户配置行的最小可读宽度，避免窗口过窄时控件挤出卡片。 -->
        <Style Selector="Grid.settings-row">
            <Setter Property="MinWidth" Value="320" />
        </Style>

        <!-- 固定设置行中的开关宽度，隐藏 On/Off 后仍保持稳定尺寸。 -->
        <Style Selector="Grid.settings-row ToggleSwitch">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="46" />
        </Style>

        <!-- 允许设置行里的输入控件跟随列宽收缩。 -->
        <Style Selector="Grid.settings-row ComboBox">
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style Selector="Grid.settings-row TextBox">
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <!-- 允许设置行里的工具按钮在窄屏时由容器裁切，而不是撑开布局。 -->
        <Style Selector="Grid.settings-row Button.tool-button">
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <!-- 功能中心卡片行使用独立局部样式，避免窄屏时按钮撑出容器。 -->
        <Style Selector="Grid.feature-row">
            <Setter Property="MinWidth" Value="320" />
        </Style>

        <Style Selector="Grid.feature-row ComboBox">
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style Selector="Grid.feature-row Button">
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style Selector="Window.dark Border.dark-disabled-buttons Button:disabled">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Foreground" Value="#9AA0A8" />
        </Style>

        <Style Selector="Window.dark Border.dark-disabled-buttons Button:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Background" Value="{DynamicResource WorkbenchButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchButtonBorderBrush}" />
            <Setter Property="Foreground" Value="#9AA0A8" />
        </Style>

        <Style Selector="Window.dark Border.disabled-feature-card">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Window.dark Border.module-actions ComboBox /template/ PathIcon#PART_DropDownGlyph">
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchControlBorderBrush}" />
        </Style>

        <Style Selector="Border.module-actions TextBlock.connection-status.connected">
            <Setter Property="Foreground" Value="#4CAF50" />
        </Style>

        <Style Selector="Window.dark Border.module-actions TextBlock.connection-status.disconnected">
            <Setter Property="Foreground" Value="#d38263" />
        </Style>
    </Window.Styles>

    <Grid>
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Height="34"
                Background="{DynamicResource WorkbenchTitleBrush}"
                BorderBrush="{DynamicResource WorkbenchBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0"
                        Background="Transparent"
                        chrome:WindowDecorationProperties.ElementRole="TitleBar">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                Margin="10,0,14,0"
                                VerticalAlignment="Center">
                        <Image Source="/Assets/favicon.ico"
                               Width="16"
                               Height="16"
                               VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding WindowTitle}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource WorkbenchTextBrush}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1"
                        Background="Transparent"
                        chrome:WindowDecorationProperties.ElementRole="TitleBar"/>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <Button Classes="window-caption-button"
                            Content="−"
                            Click="MinimizeButton_Click"
                            ToolTip.Tip="最小化"/>
                    <Button x:Name="MaximizeRestoreButton"
                            Classes="window-caption-button"
                            Content="□"
                            Click="MaximizeRestoreButton_Click"
                            ToolTip.Tip="最大化"/>
                    <Button Classes="window-caption-button close"
                            Content="×"
                            Click="CloseButton_Click"
                            ToolTip.Tip="关闭"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid RowDefinitions="*,Auto">

            <!-- 上部主操作区：三列布局 -->
            <Grid Grid.Row="0" ColumnDefinitions="220,*,300"
                  ClipToBounds="True">

            <!-- 第一列：文件层级侧边栏 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource WorkbenchSideBrush}"
                    BorderBrush="{DynamicResource WorkbenchBorderBrush}"
                    BorderThickness="{DynamicResource WorkbenchSidebarDividerThickness}">
                <Grid>
                    <views:FileTreeView DataContext="{Binding FileTreeVM}" />
                    <Border Width="10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource WorkbenchShadowToLeftBrush}"
                            IsHitTestVisible="False"
                            IsVisible="{DynamicResource WorkbenchClassicShadowVisible}"
                            ZIndex="1"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="0"
                          Width="4"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="CurrentAndNext"
                          ResizeDirection="Columns"
                          ZIndex="10"/>

            <!-- 第二列：标签切换（文本编辑器 / 标签编辑器 / 用户配置 / 功能中心） -->
            <Border Grid.Column="1"
                    Background="{DynamicResource WorkbenchPanelBrush}">
                <TabControl Classes="folder-tabs"
                            SelectedIndex="{Binding SelectedEditorTab}">
                    <TabControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"
                                         ClipToBounds="True"/>
                        </ItemsPanelTemplate>
                    </TabControl.ItemsPanel>
                    <TabItem Classes="tab-layer-0"
                             Header="文本编辑">
                        <Grid RowDefinitions="Auto,*"
                              Background="{DynamicResource WorkbenchPanelBrush}">
                            <!-- 脚本路径栏 -->
                            <Border Grid.Row="0"
                                    Padding="8,4"
                                    Background="{DynamicResource WorkbenchPanelBrush}"
                                    BorderBrush="{DynamicResource WorkbenchBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto,Auto,24">
                                    <TextBlock Text="{Binding ScriptDisplayPath}"
                                               FontSize="12"
                                               Foreground="{DynamicResource WorkbenchMutedTextBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="2"
                                                VerticalAlignment="Center"
                                                Margin="8,0,12,0">
                                        <Button Classes="editor-toolbar-button"
                                                Command="{Binding SaveScriptCommand}"
                                                ToolTip.Tip="保存">
                                            <PathIcon Data="M0,0 H12 L16,4 V16 H0 Z M3,0 V6 H11 V0 Z M3,10 H13 V15 H3 Z"
                                                       Width="13" Height="13"/>
                                        </Button>
                                        <Button Classes="editor-toolbar-button"
                                                Command="{Binding SaveScriptAsCommand}"
                                                ToolTip.Tip="另存为">
                                            <PathIcon Data="M0,0 H12 L16,4 V16 H0 Z M3,0 V6 H11 V0 Z M3,10 H13 V15 H3 Z M10,10 L16,13 L10,16 Z"
                                                       Width="13" Height="13"/>
                                        </Button>
                                        <Button Classes="editor-toolbar-button"
                                                Command="{Binding CloseScriptCommand}"
                                                ToolTip.Tip="关闭">
                                            <PathIcon Data="M1,0 L8,7 L15,0 L16,1 L9,8 L16,15 L15,16 L8,9 L1,16 L0,15 L7,8 L0,1 Z"
                                                       Width="12" Height="12"/>
                                        </Button>
                                        <Button Classes="editor-toolbar-button"
                                                Command="{Binding FormatScriptCommand}"
                                                ToolTip.Tip="格式化">
                                            <PathIcon Data="M13,3 C16,6 16,10 13,13 L11,11 C13,9 13,7 11,5 Z M3,13 C0,10 0,6 3,3 L5,5 C3,7 3,9 5,11 Z M12,1 L16,4 L12,4 Z M4,15 L0,12 L4,12 Z"
                                                       Width="13" Height="13"/>
                                        </Button>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Classes="flat-link"
                                            Content="脚本语法"
                                            Command="{Binding ShowScriptSyntaxCommand}"/>
                                    <Border Grid.Column="3"
                                            Classes="help-dot"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="?"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource WorkbenchOnAccentBrush}"
                                                   FontSize="12"
                                                   FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <!-- 编辑器始终显示 -->
                            <Grid Grid.Row="1"
                                  Background="{DynamicResource WorkbenchInputBrush}">
                                <editor:ScriptEditorControl x:Name="ScriptEditor"
                                                            EditorText="{Binding EditorText, Mode=TwoWay}"
                                                            EnableAutoCompletion="{Binding IsAutoCompletionEnabled}"/>
                                <Button Classes="ai-agent"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,10,10"
                                        Content="✦ AI Agent"
                                        Command="{Binding OpenAiAgentCommand}"
                                        IsVisible="{Binding !AiAgent.IsOpen}"/>
                            </Grid>
                            <agent:AiAgentView Grid.RowSpan="2"
                                                DataContext="{Binding AiAgent}"/>
                        </Grid>
                    </TabItem>
                    <TabItem Classes="tab-layer-1"
                             Header="标签编辑">
                        <Border Background="{DynamicResource WorkbenchPanelBrush}">
                            <tag:TagEditorView x:Name="TagEditor" DataContext="{Binding TagEditorViewModel}"/>
                        </Border>
                    </TabItem>
                    <TabItem Classes="tab-layer-2"
                             Header="用户配置">
                        <ScrollViewer Classes="settings-scroll"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      MinWidth="340">
                            <StackPanel Classes="settings-page">
                                <Border Classes="settings-card">
                                    <StackPanel Spacing="12">
                                        <TextBlock Classes="card-title"
                                                   Text="关于"/>
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                            <TextBlock Text="{Binding CurrentVersion}"
                                                       VerticalAlignment="Center"/>
                                            <Button Classes="tool-button card-action"
                                                    Grid.Column="2"
                                                    Command="{Binding CheckUpdateCommand}"
                                                    IsEnabled="{Binding !IsCheckingUpdate}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse Width="12" Height="12"
                                                             Stroke="{DynamicResource SystemAccentColor}"
                                                             StrokeThickness="2"
                                                             StrokeDashArray="2.5,1.5"
                                                             IsVisible="{Binding IsCheckingUpdate}">
                                                        <Ellipse.RenderTransform>
                                                            <RotateTransform Angle="0"/>
                                                        </Ellipse.RenderTransform>
                                                        <Ellipse.Styles>
                                                            <Style Selector="Ellipse">
                                                                <Style.Animations>
                                                                    <Animation Duration="0:0:0.8"
                                                                               IterationCount="Infinite">
                                                                        <KeyFrame Cue="0%">
                                                                            <Setter Property="(RotateTransform.Angle)" Value="0"/>
                                                                        </KeyFrame>
                                                                        <KeyFrame Cue="100%">
                                                                            <Setter Property="(RotateTransform.Angle)" Value="360"/>
                                                                        </KeyFrame>
                                                                    </Animation>
                                                                </Style.Animations>
                                                            </Style>
                                                        </Ellipse.Styles>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding CheckUpdateButtonText}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="tool-button card-action"
                                                    Grid.Column="3"
                                                    Command="{Binding OpenGitHubCommand}"
                                                    ToolTip.Tip="在浏览器中打开 GitHub">
                                                <Path Data="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.463-1.11-1.463-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.416 22 12c0-5.523-4.477-10-10-10z"
                                                      Width="14" Height="14"
                                                      Fill="{DynamicResource SystemAccentColor}"
                                                      Stretch="Uniform"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Classes="settings-card">
                                    <StackPanel Spacing="14">
                                        <TextBlock Classes="card-title"
                                                   Text="配置"/>

                                        <Grid Classes="settings-row"
                                              ColumnDefinitions="110,*,Auto">
                                            <TextBlock Text="采集卡类型"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding CaptureTypeOptions}"
                                                      SelectedItem="{Binding SelectedCaptureType}"
                                                      HorizontalAlignment="Stretch"/>
                                            <Button Grid.Column="2"
                                                    Classes="tool-button"
                                                    Content="设置环境变量"
                                                    Margin="8,0,0,0"/>
                                        </Grid>

                                        <Grid Classes="settings-row"
                                              ColumnDefinitions="*,Auto">
                                            <TextBlock Text="推送设置"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="1"
                                                    Classes="tool-button"
                                                    Content="打开配置"
                                                    Command="{Binding OpenAlertConfigCommand}"/>
                                        </Grid>

                                        <Grid Classes="settings-row"
                                              ColumnDefinitions="*,Auto">
                                            <TextBlock Text="代码自动补全"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <ToggleSwitch Grid.Column="1"
                                                          OnContent=""
                                                          OffContent=""
                                                          IsChecked="{Binding IsAutoCompletionEnabled}"/>
                                        </Grid>

                                        <Grid Classes="settings-row"
                                              ColumnDefinitions="*,Auto">
                                            <TextBlock Text="显示代码折叠"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <ToggleSwitch Grid.Column="1"
                                                          OnContent=""
                                                          OffContent=""
                                                          IsChecked="{Binding ShowFolding}"/>
                                        </Grid>

                                        <Grid Classes="settings-row"
                                              ColumnDefinitions="*,Auto">
                                            <TextBlock Text="高精度模式"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <ToggleSwitch Grid.Column="1"
                                                          OnContent=""
                                                          OffContent=""
                                                          IsChecked="{Binding IsHighResolutionTimingEnabled}"/>
                                        </Grid>

                                    </StackPanel>
                                </Border>

                                <Border Classes="settings-card">
                                    <StackPanel Spacing="14">
                                        <TextBlock Classes="card-title"
                                                   Text="外观样式"/>

                                        <Grid Classes="settings-row"
                                              ColumnDefinitions="110,*,Auto">
                                            <TextBlock Text="欢迎词"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding WelcomeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     PlaceholderText="欢迎使用 easycon"
                                                     HorizontalAlignment="Stretch"/>
                                            <Button Grid.Column="2"
                                                    Classes="tool-button"
                                                    Content="重置"
                                                    Command="{Binding ResetWelcomeTextCommand}"
                                                    Margin="8,0,0,0"/>
                                        </Grid>

                                        <TextBlock Classes="setting-caption"
                                                   Text="风格"/>
                                        <Grid ColumnDefinitions="*,*,*"
                                              ColumnSpacing="10">
                                            <Button Grid.Column="0"
                                                    Classes="theme-option"
                                                    Command="{Binding SelectThemeStyleCommand}"
                                                    CommandParameter="经典">
                                                <Border Classes="theme-preview classic">
                                                    <StackPanel Spacing="8">
                                                        <Border Classes="theme-strip"/>
                                                        <TextBlock Text="经典"
                                                                   FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Classes="theme-option"
                                                    Command="{Binding SelectThemeStyleCommand}"
                                                    CommandParameter="卡片式">
                                                <Border Classes="theme-preview rounded">
                                                    <StackPanel Spacing="8">
                                                        <Border Classes="theme-strip"/>
                                                        <TextBlock Text="卡片式"
                                                                   FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Classes="theme-option"
                                                    Command="{Binding SelectThemeStyleCommand}"
                                                    CommandParameter="磨砂玻璃">
                                                <Border Classes="theme-preview glass">
                                                    <StackPanel Spacing="8">
                                                        <Border Classes="theme-strip"/>
                                                        <TextBlock Text="磨砂玻璃"
                                                                   FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </Grid>

                                        <TextBlock Classes="setting-caption"
                                                   Text="配色"/>
                                        <Grid ColumnDefinitions="*,*,*"
                                              ColumnSpacing="10">
                                            <Button Grid.Column="0"
                                                    Classes="theme-option"
                                                    Command="{Binding SelectColorSchemeCommand}"
                                                    CommandParameter="白色">
                                                <Border Classes="theme-preview white">
                                                    <StackPanel Spacing="8">
                                                        <Border Classes="theme-strip"/>
                                                        <TextBlock Text="白色"
                                                                   FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Classes="theme-option"
                                                    Command="{Binding SelectColorSchemeCommand}"
                                                    CommandParameter="暖色">
                                                <Border Classes="theme-preview light">
                                                    <StackPanel Spacing="8">
                                                        <Border Classes="theme-strip"/>
                                                        <TextBlock Text="暖色"
                                                                   FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Classes="theme-option"
                                                    Command="{Binding SelectColorSchemeCommand}"
                                                    CommandParameter="Dark模式">
                                                <Border Classes="theme-preview dark">
                                                    <StackPanel Spacing="8">
                                                        <Border Classes="theme-strip"/>
                                                        <TextBlock Text="深色"
                                                                   FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </Grid>

                                        <Border Classes="inline-config-panel">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnDefinitions="*,Auto,Auto"
                                                      ColumnSpacing="10">
                                                    <TextBlock Text="窗口栏"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="视运行状态自动切换布局"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                    <ToggleSwitch Grid.Column="2"
                                                                  OnContent=""
                                                                  OffContent=""
                                                                  IsChecked="{Binding AutoSwitchLayoutEnabled}"/>
                                                </Grid>

                                                <StackPanel IsEnabled="{Binding AutoSwitchLayoutEnabled}"
                                                            Spacing="12">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="自定义布局区域"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1"
                                                                Classes="tool-button"
                                                                Content="恢复默认"
                                                                Command="{Binding RestoreDefaultLayoutCommand}"/>
                                                    </Grid>

                                                    <TextBlock Classes="setting-caption"
                                                               Text="未运行时预览"/>
                                                    <Grid ColumnDefinitions="*,*"
                                                          ColumnSpacing="10">
                                                        <RadioButton Classes="layout-option"
                                                                     GroupName="IdleLayoutOptions"
                                                                     IsChecked="{Binding IsIdleThreeColumnLayoutSelected}">
                                                            <Border Classes="layout-preview">
                                                                <Grid ColumnDefinitions="0.7*,1.9*,0.8*"
                                                                      ColumnSpacing="4">
                                                                    <Border Classes="layout-cell tree-cell">
                                                                        <TextBlock Text="工作树"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <Border Grid.Column="1"
                                                                            Classes="layout-cell editor-cell">
                                                                        <TextBlock Text="编辑区"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <Grid Grid.Column="2"
                                                                          RowDefinitions="*,*"
                                                                          RowSpacing="4">
                                                                        <Border Classes="layout-cell video-cell">
                                                                            <TextBlock Text="视频源"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <Border Grid.Row="1"
                                                                                Classes="layout-cell output-cell">
                                                                            <TextBlock Text="输出区"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </Grid>
                                                                </Grid>
                                                            </Border>
                                                        </RadioButton>

                                                        <RadioButton Grid.Column="1"
                                                                     Classes="layout-option"
                                                                     GroupName="IdleLayoutOptions"
                                                                     IsChecked="{Binding IsIdleTwoColumnLayoutSelected}">
                                                            <Border Classes="layout-preview">
                                                                <Grid ColumnDefinitions="0.7*,2.6*"
                                                                      ColumnSpacing="4">
                                                                    <Border Classes="layout-cell tree-cell">
                                                                        <TextBlock Text="工作树"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <Border Grid.Column="1"
                                                                            Classes="layout-cell editor-cell">
                                                                        <TextBlock Text="编辑区"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </RadioButton>
                                                    </Grid>

                                                    <TextBlock Classes="setting-caption"
                                                               Text="运行时预览"/>
                                                    <Grid ColumnDefinitions="*,*,*"
                                                          ColumnSpacing="10">
                                                        <RadioButton Classes="layout-option"
                                                                     GroupName="RunningLayoutOptions"
                                                                     IsChecked="{Binding IsRunningThreeColumnLayoutSelected}">
                                                            <Border Classes="layout-preview">
                                                                <Grid ColumnDefinitions="0.7*,1.9*,0.8*"
                                                                      ColumnSpacing="4">
                                                                    <Border Classes="layout-cell tree-cell">
                                                                        <TextBlock Text="工作树"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <Border Grid.Column="1"
                                                                            Classes="layout-cell editor-cell">
                                                                        <TextBlock Text="编辑区"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <Grid Grid.Column="2"
                                                                          RowDefinitions="*,*"
                                                                          RowSpacing="4">
                                                                        <Border Classes="layout-cell video-cell">
                                                                            <TextBlock Text="视频源"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <Border Grid.Row="1"
                                                                                Classes="layout-cell output-cell">
                                                                            <TextBlock Text="输出区"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </Grid>
                                                                </Grid>
                                                            </Border>
                                                        </RadioButton>

                                                        <RadioButton Grid.Column="1"
                                                                     Classes="layout-option"
                                                                     GroupName="RunningLayoutOptions"
                                                                     IsChecked="{Binding IsRunningTwoColumnLayoutSelected}">
                                                            <Border Classes="layout-preview">
                                                                <Grid ColumnDefinitions="*,*"
                                                                      ColumnSpacing="4">
                                                                    <Border Classes="layout-cell video-cell">
                                                                        <TextBlock Text="视频源"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <Border Grid.Column="1"
                                                                            Classes="layout-cell output-cell">
                                                                        <TextBlock Text="输出区"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </RadioButton>

                                                        <RadioButton Grid.Column="2"
                                                                     Classes="layout-option"
                                                                     GroupName="RunningLayoutOptions"
                                                                     IsChecked="{Binding IsRunningOneColumnLayoutSelected}">
                                                            <Border Classes="layout-preview">
                                                                <Border Classes="layout-cell output-cell">
                                                                    <TextBlock Text="输出区"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                            </Border>
                                                        </RadioButton>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Classes="tab-layer-3"
                             Header="功能中心">
                        <ScrollViewer Classes="settings-scroll"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      MinWidth="340">
                            <StackPanel Classes="settings-page">
                                <Border Classes="settings-card">
                                    <StackPanel Spacing="12">
                                        <TextBlock Classes="card-title"
                                                   Text="远程运行"/>
                                        <Grid Classes="feature-row"
                                              ColumnDefinitions="*,*"
                                              ColumnSpacing="10">
                                            <Button Content="远程运行"
                                                    Command="{Binding RemoteRunCommand}"
                                                    HorizontalAlignment="Stretch"/>
                                            <Button Grid.Column="1"
                                                    Content="远程停止"
                                                    Command="{Binding RemoteStopCommand}"
                                                    HorizontalAlignment="Stretch"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Classes="settings-card">
                                    <StackPanel Spacing="12">
                                        <TextBlock Classes="card-title"
                                                   Text="编译烧录"/>
                                        <Grid Classes="feature-row"
                                              ColumnDefinitions="*,*"
                                              ColumnSpacing="10">
                                            <Button Content="编译烧录"
                                                    Command="{Binding CompileFlashCommand}"
                                                    HorizontalAlignment="Stretch"/>
                                            <Button Grid.Column="1"
                                                    Content="清除烧录"
                                                    Command="{Binding ClearFlashCommand}"
                                                    HorizontalAlignment="Stretch"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Classes="settings-card">
                                    <StackPanel Spacing="12">
                                        <TextBlock Classes="card-title"
                                                   Text="固件"/>
                                        <Grid Classes="feature-row"
                                              ColumnDefinitions="*,Auto"
                                              ColumnSpacing="10">
                                            <ComboBox ItemsSource="{Binding FirmwareOptions}"
                                                      SelectedItem="{Binding SelectedFirmware}"
                                                      HorizontalAlignment="Stretch"/>
                                            <Button Grid.Column="1"
                                                    Content="生成"
                                                    Command="{Binding GenerateFirmwareCommand}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Classes="settings-card">
                                    <Grid Classes="feature-row"
                                          ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="card-title"
                                                       Text="蓝牙手柄设置"/>
                                            <TextBlock Classes="setting-caption"
                                                       Text="ESP32 手柄参数配置"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="配置"
                                                Command="{Binding OpenESPConfigCommand}"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Classes="settings-card dark-disabled-buttons disabled-feature-card"
                                        IsEnabled="False"
                                        Opacity="0.5">
                                    <StackPanel Spacing="12">
                                        <TextBlock Classes="card-title"
                                                   Text="画图"/>
                                        <Grid Classes="feature-row"
                                              ColumnDefinitions="*,*"
                                              ColumnSpacing="10">
                                            <Button Content="喷射战士"
                                                    HorizontalAlignment="Stretch"/>
                                            <Button Grid.Column="1"
                                                    Content="自由画板"
                                                    HorizontalAlignment="Stretch"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- 第二列与第三列之间的拖拽分割线 -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="CurrentAndNext"
                          ResizeDirection="Columns"
                          ZIndex="10"/>

            <!-- 第三列：监视器（上） + 日志（下） -->
            <Grid Grid.Column="2"
                  RowDefinitions="*,*"
                  Background="{DynamicResource WorkbenchPanelBrush}">

                <!-- 第三列上半部分：监视器 -->
                <Border Grid.Row="0"
                        Background="{DynamicResource WorkbenchPanelBrush}"
                        BorderBrush="{DynamicResource WorkbenchBorderBrush}"
                        BorderThickness="{DynamicResource WorkbenchBottomDividerThickness}"
                        ClipToBounds="True"
                        DoubleTapped="MonitorArea_DoubleTapped">
                    <Grid Background="{DynamicResource WorkbenchPanelBrush}">
                        <Grid IsVisible="{Binding IsMonitorVisible}">
                            <views:MonitorView DataContext="{Binding MonitorVM}" />
                        </Grid>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="8"
                                Classes="flat-link"
                                Content="{Binding MonitorVisibilityButtonText}"
                                Command="{Binding ToggleMonitorVisibilityCommand}"/>
                        <Border Height="10"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource WorkbenchShadowToTopBrush}"
                                IsHitTestVisible="False"
                                IsVisible="{DynamicResource WorkbenchClassicShadowVisible}"/>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="0"
                              Height="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Bottom"
                              Background="Transparent"
                              ResizeBehavior="CurrentAndNext"
                              ResizeDirection="Rows"
                              ZIndex="10"/>

                <!-- 第三列下半部分：日志输出 -->
                <Grid Grid.Row="1"
                      RowDefinitions="34,*"
                      Background="{DynamicResource WorkbenchLogBrush}">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="*,Auto,34"
                          Background="{DynamicResource WorkbenchPanelBrush}">
                        <TextBlock Text="输出窗口"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource WorkbenchMutedTextBrush}"
                                   FontSize="12"/>
                        <TextBlock Grid.Column="1"
                                   Text="调试模式"
                                   Margin="0,0,4,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource WorkbenchMutedTextBrush}"
                                   FontSize="12"/>
                        <ToggleButton Grid.Column="2"
                                      Classes="debug-switch"
                                      IsChecked="{Binding ShowDebugInfo}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="1" RowDefinitions="26,*">
                        <Grid Grid.Row="0"
                              ColumnDefinitions="*,Auto"
                              Background="{DynamicResource WorkbenchLogBrush}"
                              ClipToBounds="True">
                            <terminal:TerminalControl Grid.Column="0"
                                                      ItemsSource="{Binding WelcomeLines}"
                                                      MaxLineCount="1"
                                                      AutoScroll="False"
                                                      MarqueeHorizontalOverflow="True"
                                                      ContentPadding="10,4,0,0"/>
                            <Button Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Classes="flat-link"
                                    Content="清空输出 ↻"
                                    Foreground="{DynamicResource WorkbenchAmberBrush}"
                                    Command="{Binding ClearLogCommand}"
                                    Margin="8,0,12,0"/>
                        </Grid>
                        <Grid Grid.Row="1"
                              Background="{DynamicResource WorkbenchLogBrush}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          Background="{DynamicResource WorkbenchLogBrush}">
                                <terminal:TerminalControl
                                    ItemsSource="{Binding LogLines}"
                                    ContentPadding="10,0,0,0"/>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
                <Border Grid.RowSpan="2"
                        Width="10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource WorkbenchShadowToRightBrush}"
                        IsHitTestVisible="False"
                        IsVisible="{DynamicResource WorkbenchClassicShadowVisible}"
                        ZIndex="20"/>
            </Grid>

            <Border Grid.ColumnSpan="3"
                    Height="12"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource WorkbenchShadowToTopBrush}"
                    IsHitTestVisible="False"
                    IsVisible="{DynamicResource WorkbenchClassicShadowVisible}"
                    ZIndex="20"/>
        </Grid>

        <!-- 下部模块操作区 -->
        <Border Grid.Row="1"
               Classes="module-actions dark-disabled-buttons"
               Padding="10"
               Background="{DynamicResource WorkbenchPanelBrush}"
               BorderBrush="{DynamicResource WorkbenchBorderBrush}"
               BorderThickness="{DynamicResource WorkbenchTopDividerThickness}">
            <Grid ColumnDefinitions="*,*,*,*"
                 HorizontalAlignment="Stretch">

                <!-- 第一个模块：单片机连接 -->
                <GroupBox Grid.Column="0"
                          Margin="5"
                          Padding="10">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="单片机连接" FontWeight="Bold"/>
                            <TextBlock Text="{Binding NintendoSwitchStatus}"
                                       FontWeight="Bold"
                                       Classes="connection-status"
                                       Classes.connected="{Binding IsNintendoSwitchConnected}"
                                       Classes.disconnected="{Binding !IsNintendoSwitchConnected}"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel Orientation="Vertical" Spacing="10">
                        <ComboBox ItemsSource="{Binding SerialPortOptions}"
                                  SelectedItem="{Binding SelectedSerialPort}"
                                  HorizontalAlignment="Stretch"
                                  behaviors:DropDownRefreshBehavior.RefreshCommand="{Binding RefreshSerialPortsCommand}"/>
                        <Grid ColumnDefinitions="*,*">
                            <Button Grid.Column="0"
                                    Content="{Binding NintendoSwitchButtonText}"
                                    Command="{Binding ConnectNintendoSwitchCommand}"
                                    IsEnabled="{Binding !IsConnectingNintendoSwitch}"
                                    Margin="0,0,5,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="自动连接"
                                    Command="{Binding AutoConnectNintendoSwitchCommand}"
                                    IsEnabled="{Binding !IsConnectingNintendoSwitch}"
                                    Classes="outline-accent"
                                    Margin="5,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 第二个模块：视频源 -->
                <GroupBox Grid.Column="1"
                          Margin="5"
                          Padding="10">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="视频源" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CaptureSourceStatus}"
                                       FontWeight="Bold"
                                       Classes="connection-status"
                                       Classes.connected="{Binding IsCaptureSourceConnected}"
                                       Classes.disconnected="{Binding !IsCaptureSourceConnected}"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel Orientation="Vertical" Spacing="10">
                        <ComboBox ItemsSource="{Binding CaptureSourceOptions}"
                                  SelectedItem="{Binding SelectedCaptureSource}"
                                  HorizontalAlignment="Stretch"
                                  behaviors:DropDownRefreshBehavior.RefreshCommand="{Binding RefreshCaptureSourcesCommand}"/>
                        <Button Content="{Binding CaptureSourceButtonText}"
                                Command="{Binding ConnectCaptureSourceCommand}"
                                IsEnabled="{Binding !IsConnectingCaptureSource}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </GroupBox>

                <!-- 第三个模块：虚拟手柄 -->
                <GroupBox Grid.Column="2"
                          Margin="5"
                          Padding="10">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="虚拟手柄" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ControlSourceStatus}"
                                       FontWeight="Bold"
                                       Classes="connection-status"
                                       Classes.connected="{Binding IsControllerConnected}"
                                       Classes.disconnected="{Binding !IsControllerConnected}"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="*,Auto,Auto"
                          RowSpacing="10"
                          ColumnSpacing="10">
                        <!-- 第一排：下拉框 + 开启映射按钮 -->
                        <Grid Grid.Row="0"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              ColumnDefinitions="*">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding ControlSourceOptions}"
                                      SelectedItem="{Binding SelectedControlSource}"
                                      HorizontalAlignment="Stretch"
                                      behaviors:DropDownRefreshBehavior.RefreshCommand="{Binding RefreshControlSourcesCommand}"/>
                        </Grid>
                        <Button Grid.Row="0"
                                Grid.Column="2"
                                Content="{Binding ControllerButtonText}"
                                Command="{Binding ConnectControllerCommand}"
                                IsEnabled="{Binding !IsConnectingController}"
                                Padding="8,4"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"/>
                        <!-- 第二排：录制脚本 + 停止录制 + 按键映射 -->
                        <Grid Grid.Row="1"
                              Grid.Column="0"
                              Grid.ColumnSpan="3"
                              ColumnDefinitions="*,*,*"
                              ColumnSpacing="10">
                            <Button Grid.Column="0"
                                    Content="录制脚本"
                                    Command="{Binding StartRecordCommand}"
                                    IsEnabled="{Binding IsStartRecordEnabled}"
                                    Padding="12,4"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="停止录制"
                                    Command="{Binding StopRecordCommand}"
                                    IsEnabled="{Binding IsStopRecordEnabled}"
                                    Padding="12,4"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"/>
                            <Button Grid.Column="2"
                                    Content="按键映射"
                                    Command="{Binding EditKeyMappingCommand}"
                                    IsEnabled="{Binding IsEditKeyMappingEnabled}"
                                    Padding="12,4"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"/>
                        </Grid>
                    </Grid>
                </GroupBox>

                <!-- 运行脚本按钮（不变） -->
                <Border Grid.Column="3"
                        Margin="5"
                        Padding="10"
                        Background="{DynamicResource WorkbenchPanelBrush}">
                    <Grid>
                        <StackPanel Orientation="Vertical"
                                    HorizontalAlignment="Stretch"
                                    Spacing="8">
                            <TextBlock Text="{Binding RunTimeDisplay}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       FontFamily="Consolas"
                                       Foreground="{DynamicResource WorkbenchMutedTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <Button Content="{Binding RunButtonText}"
                                    Command="{Binding RunScriptCommand}"
                                    Classes="run-button"
                                    Classes.running="{Binding IsRunning}"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource WorkbenchOnAccentBrush}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        </Grid>
    </DockPanel>
    <Border Tag="North"
            Height="6"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Background="Transparent"
            Cursor="TopSide"
            PointerPressed="ResizeEdge_PointerPressed"
            ZIndex="1000"/>
    <Border Tag="South"
            Height="6"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Background="Transparent"
            Cursor="BottomSide"
            PointerPressed="ResizeEdge_PointerPressed"
            ZIndex="1000"/>
    <Border Tag="West"
            Width="6"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            Background="Transparent"
            Cursor="LeftSide"
            PointerPressed="ResizeEdge_PointerPressed"
            ZIndex="1000"/>
    <Border Tag="East"
            Width="6"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Background="Transparent"
            Cursor="RightSide"
            PointerPressed="ResizeEdge_PointerPressed"
            ZIndex="1000"/>
    <Border Tag="NorthWest"
            Width="10"
            Height="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Transparent"
            Cursor="TopLeftCorner"
            PointerPressed="ResizeEdge_PointerPressed"
            ZIndex="1001"/>
    <Border Tag="NorthEast"
            Width="10"
            Height="10"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="Transparent"
            Cursor="TopRightCorner"
            PointerPressed="ResizeEdge_PointerPressed"
            ZIndex="1001"/>
    <Border Tag="SouthWest"
            Width="10"
            Height="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Background="Transparent"
            Cursor="BottomLeftCorner"
            PointerPressed="ResizeEdge_PointerPressed"
            ZIndex="1001"/>
    <Border Tag="SouthEast"
            Width="10"
            Height="10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="Transparent"
            Cursor="BottomRightCorner"
            PointerPressed="ResizeEdge_PointerPressed"
            ZIndex="1001"/>
    </Grid>
</Window>

