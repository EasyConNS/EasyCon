<Window xmlns="https://github.com/avaloniaui"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:vm="using:EasyCon2.Avalonia.ViewModels"
         xmlns:conv="using:EasyCon2.Avalonia.Converters"
         xmlns:behaviors="using:EasyCon2.Avalonia.Behaviors"
         xmlns:controls="using:EasyCon2.Avalonia.Controls"
         xmlns:editor="using:EasyCon2.Avalonia.Core.Editor"
         xmlns:tag="using:EasyCon2.Avalonia.Core.TagEditor"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         mc:Ignorable="d"
         d:DesignWidth="1200"
         d:DesignHeight="800"
 x:Class="EasyCon2.Avalonia.Views.MainWindow"
          x:DataType="vm:MainWindowViewModel"
          Icon="/Assets/favicon.ico"
          Title="{Binding WindowTitle}"
          Width="1200"
          Height="800"
          MinWidth="800"
          MinHeight="600"
          Background="{DynamicResource WorkbenchWindowBrush}"
          behaviors:FileDropBehavior.Command="{Binding DropFileCommand}">

    <Window.Resources>
        <conv:BoolToGreenBrushConverter x:Key="BoolToGreenBrush" />
        <conv:BoolToRunColorConverter x:Key="BoolToRunColor" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="ToggleButton.debug-switch">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="16" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Width="30"
                           Height="16">
                        <Border x:Name="SwitchTrack"
                                Width="30"
                                Height="16"
                                CornerRadius="8"
                                Background="{DynamicResource WorkbenchInputBrush}"
                                BorderBrush="{DynamicResource WorkbenchMutedTextBrush}"
                                BorderThickness="1"/>
                        <Border x:Name="SwitchThumb"
                                Width="10"
                                Height="10"
                                Margin="4,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                CornerRadius="5"
                                Background="{DynamicResource WorkbenchLogTextBrush}"/>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.debug-switch:checked /template/ Border#SwitchTrack">
            <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchAccentBrush}" />
        </Style>
        <Style Selector="ToggleButton.debug-switch:checked /template/ Border#SwitchThumb">
            <Setter Property="Margin" Value="16,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource WorkbenchAccentBrush}" />
        </Style>
        <Style Selector="Button.editor-toolbar-button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchMutedTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.editor-toolbar-button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WorkbenchButtonHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchControlBorderBrush}" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <Grid RowDefinitions="*,Auto">

            <!-- 上部主操作区：三列布局 -->
            <Grid Grid.Row="0" ColumnDefinitions="220,*,5,300">

            <!-- 第一列：文件层级侧边栏 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource WorkbenchSideBrush}"
                    BorderBrush="{DynamicResource WorkbenchBorderBrush}"
                    BorderThickness="0,0,1,0">
                <ContentControl Content="{Binding FileTreeView}" />
            </Border>

            <!-- 第二列：标签切换（文本编辑器 / 标签编辑器 / 用户配置 / 功能中心） -->
            <Border Grid.Column="1"
                    Background="{DynamicResource WorkbenchWindowBrush}">
                <TabControl Classes="folder-tabs"
                            SelectedIndex="{Binding SelectedEditorTab}">
                    <TabControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"
                                         ClipToBounds="False"/>
                        </ItemsPanelTemplate>
                    </TabControl.ItemsPanel>
                    <TabItem Classes="tab-layer-0"
                             Header="文本编辑">
                        <Grid RowDefinitions="Auto,*">
                            <!-- 脚本路径栏 -->
                            <Border Grid.Row="0"
                                    Padding="8,4"
                                    Background="{DynamicResource WorkbenchPanelBrush}"
                                    BorderBrush="{DynamicResource WorkbenchBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto,Auto,24">
                                    <TextBlock Text="{Binding ScriptDisplayPath}"
                                               FontSize="12"
                                               Foreground="{DynamicResource WorkbenchMutedTextBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="2"
                                                VerticalAlignment="Center"
                                                Margin="8,0,12,0">
                                        <Button Classes="editor-toolbar-button"
                                                Command="{Binding SaveScriptCommand}"
                                                CommandParameter="{Binding $parent[Window]}"
                                                ToolTip.Tip="保存">
                                            <TextBlock Text="&#xE74E;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13"/>
                                        </Button>
                                        <Button Classes="editor-toolbar-button"
                                                Command="{Binding SaveScriptAsCommand}"
                                                CommandParameter="{Binding $parent[Window]}"
                                                ToolTip.Tip="另存为">
                                            <TextBlock Text="&#xE792;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13"/>
                                        </Button>
                                        <Button Classes="editor-toolbar-button"
                                                Command="{Binding CloseScriptCommand}"
                                                ToolTip.Tip="关闭">
                                            <TextBlock Text="&#xE711;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12"/>
                                        </Button>
                                        <Button Classes="editor-toolbar-button"
                                                Command="{Binding FormatScriptCommand}"
                                                ToolTip.Tip="格式化">
                                            <TextBlock Text="&#xE72C;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13"/>
                                        </Button>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Classes="flat-link"
                                            Content="脚本语法"
                                            Command="{Binding ShowScriptSyntaxCommand}"/>
                                    <Border Grid.Column="3"
                                            Classes="help-dot"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="?"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource WorkbenchOnAccentBrush}"
                                                   FontSize="12"
                                                   FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <!-- 编辑器始终显示 -->
                            <Grid Grid.Row="1">
                                <editor:ScriptEditorControl x:Name="ScriptEditor" EditorText="{Binding EditorText, Mode=TwoWay}"/>
                                <Button Classes="ai-agent"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,10,10"
                                        Content="✦ AI Agent"
                                        Command="{Binding OpenAiAgentCommand}"/>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Classes="tab-layer-1"
                             Header="标签编辑">
                        <tag:TagEditorView x:Name="TagEditor" DataContext="{Binding TagEditorViewModel}"/>
                    </TabItem>
                    <TabItem Classes="tab-layer-2"
                             Header="用户配置">
                        <ScrollViewer Classes="settings-scroll"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Classes="settings-page">
                                <Border Classes="settings-card">
                                    <StackPanel Spacing="12">
                                        <TextBlock Classes="card-title"
                                                   Text="帮助"/>
                                        <WrapPanel>
                                            <Button Classes="tool-button card-action"
                                                    Content="固件模式"/>
                                            <Button Classes="tool-button card-action"
                                                    Content="联机模式"/>
                                            <Button Classes="tool-button card-action"
                                                    Content="烧录模式"/>
                                            <Button Classes="tool-button card-action"
                                                    Content="检查更新"/>
                                            <Button Classes="tool-button card-action"
                                                    Content="项目源码"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Classes="settings-card">
                                    <StackPanel Spacing="14">
                                        <TextBlock Classes="card-title"
                                                   Text="配置"/>

                                        <Grid Classes="settings-row"
                                              ColumnDefinitions="160,*,Auto">
                                            <TextBlock Text="采集卡类型"
                                                       VerticalAlignment="Center"/>
                                            <ComboBox Grid.Column="1"
                                                      SelectedIndex="0"
                                                      HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="ANY"/>
                                                <ComboBoxItem Content="DSHOW"/>
                                                <ComboBoxItem Content="MSMF"/>
                                                <ComboBoxItem Content="DC1394"/>
                                            </ComboBox>
                                            <Button Grid.Column="2"
                                                    Classes="tool-button"
                                                    Content="设置环境变量"
                                                    Margin="8,0,0,0"/>
                                        </Grid>

                                        <Grid Classes="settings-row"
                                              ColumnDefinitions="*,Auto">
                                            <TextBlock Text="推送设置"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="1"
                                                    Classes="tool-button"
                                                    Content="添加配置"
                                                    Command="{Binding OpenAlertConfigCommand}"
                                                    CommandParameter="{Binding $parent[Window]}"/>
                                        </Grid>

                                        <Grid Classes="settings-row"
                                              ColumnDefinitions="*,Auto">
                                            <TextBlock Text="代码自动补全"
                                                       VerticalAlignment="Center"/>
                                            <ToggleSwitch Grid.Column="1"
                                                          IsChecked="False"/>
                                        </Grid>

                                        <Grid Classes="settings-row"
                                              ColumnDefinitions="*,Auto">
                                            <TextBlock Text="显示代码折叠"
                                                       VerticalAlignment="Center"/>
                                            <ToggleSwitch Grid.Column="1"
                                                          IsChecked="{Binding ShowFolding}"/>
                                        </Grid>

                                        <Grid Classes="settings-row"
                                              ColumnDefinitions="*,Auto">
                                            <TextBlock Text="高精度模式"
                                                       VerticalAlignment="Center"/>
                                            <ToggleSwitch Grid.Column="1"
                                                          IsChecked="False"/>
                                        </Grid>

                                        <Grid Classes="settings-row"
                                              ColumnDefinitions="*,Auto">
                                            <TextBlock Text="蓝牙设备驱动配置"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="1"
                                                    Classes="tool-button"
                                                    Content="设备驱动配置"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Classes="settings-card">
                                    <StackPanel Spacing="14">
                                        <TextBlock Classes="card-title"
                                                   Text="外观样式"/>

                                        <TextBlock Classes="setting-caption"
                                                   Text="主题"/>
                                        <Grid ColumnDefinitions="*,*,*"
                                              ColumnSpacing="10">
                                            <Button Grid.Column="0"
                                                    Classes="theme-option"
                                                    Command="{Binding SelectColorSchemeCommand}"
                                                    CommandParameter="工业灰">
                                                <Border Classes="theme-preview industrial">
                                                    <StackPanel Spacing="8">
                                                        <Border Classes="theme-strip"/>
                                                        <TextBlock Text="工业灰"
                                                                   FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Classes="theme-option"
                                                    Command="{Binding SelectColorSchemeCommand}"
                                                    CommandParameter="暖色调">
                                                <Border Classes="theme-preview light">
                                                    <StackPanel Spacing="8">
                                                        <Border Classes="theme-strip"/>
                                                        <TextBlock Text="浅色"
                                                                   FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Classes="theme-option"
                                                    Command="{Binding SelectColorSchemeCommand}"
                                                    CommandParameter="Dark模式">
                                                <Border Classes="theme-preview dark">
                                                    <StackPanel Spacing="8">
                                                        <Border Classes="theme-strip"/>
                                                        <TextBlock Text="深色"
                                                                   FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </Grid>

                                        <Border Classes="inline-config-panel">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnDefinitions="*,Auto,Auto"
                                                      ColumnSpacing="10">
                                                    <TextBlock Text="窗口栏"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="视运行状态自动切换布局"
                                                               VerticalAlignment="Center"/>
                                                    <ToggleSwitch Grid.Column="2"
                                                                  IsChecked="{Binding AutoSwitchLayoutEnabled}"/>
                                                </Grid>

                                                <StackPanel IsEnabled="{Binding AutoSwitchLayoutEnabled}"
                                                            Spacing="12">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="自定义布局区域"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1"
                                                                Classes="tool-button"
                                                                Content="恢复默认"
                                                                Command="{Binding RestoreDefaultLayoutCommand}"/>
                                                    </Grid>

                                                    <TextBlock Classes="setting-caption"
                                                               Text="未运行时预览"/>
                                                    <Grid ColumnDefinitions="*,*"
                                                          ColumnSpacing="10">
                                                        <RadioButton Classes="layout-option"
                                                                     GroupName="IdleLayoutOptions"
                                                                     IsChecked="{Binding IsIdleThreeColumnLayoutSelected}">
                                                            <Border Classes="layout-preview">
                                                                <Grid ColumnDefinitions="0.7*,1.9*,0.8*"
                                                                      ColumnSpacing="4">
                                                                    <Border Classes="layout-cell tree-cell">
                                                                        <TextBlock Text="工作树"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <Border Grid.Column="1"
                                                                            Classes="layout-cell editor-cell">
                                                                        <TextBlock Text="编辑区"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <Grid Grid.Column="2"
                                                                          RowDefinitions="*,*"
                                                                          RowSpacing="4">
                                                                        <Border Classes="layout-cell video-cell">
                                                                            <TextBlock Text="视频源"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <Border Grid.Row="1"
                                                                                Classes="layout-cell output-cell">
                                                                            <TextBlock Text="输出区"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </Grid>
                                                                </Grid>
                                                            </Border>
                                                        </RadioButton>

                                                        <RadioButton Grid.Column="1"
                                                                     Classes="layout-option"
                                                                     GroupName="IdleLayoutOptions"
                                                                     IsChecked="{Binding IsIdleTwoColumnLayoutSelected}">
                                                            <Border Classes="layout-preview">
                                                                <Grid ColumnDefinitions="0.7*,2.6*"
                                                                      ColumnSpacing="4">
                                                                    <Border Classes="layout-cell tree-cell">
                                                                        <TextBlock Text="工作树"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <Border Grid.Column="1"
                                                                            Classes="layout-cell editor-cell">
                                                                        <TextBlock Text="编辑区"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </RadioButton>
                                                    </Grid>

                                                    <TextBlock Classes="setting-caption"
                                                               Text="运行时预览"/>
                                                    <Grid ColumnDefinitions="*,*,*"
                                                          ColumnSpacing="10">
                                                        <RadioButton Classes="layout-option"
                                                                     GroupName="RunningLayoutOptions"
                                                                     IsChecked="{Binding IsRunningThreeColumnLayoutSelected}">
                                                            <Border Classes="layout-preview">
                                                                <Grid ColumnDefinitions="0.7*,1.9*,0.8*"
                                                                      ColumnSpacing="4">
                                                                    <Border Classes="layout-cell tree-cell">
                                                                        <TextBlock Text="工作树"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <Border Grid.Column="1"
                                                                            Classes="layout-cell editor-cell">
                                                                        <TextBlock Text="编辑区"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <Grid Grid.Column="2"
                                                                          RowDefinitions="*,*"
                                                                          RowSpacing="4">
                                                                        <Border Classes="layout-cell video-cell">
                                                                            <TextBlock Text="视频源"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <Border Grid.Row="1"
                                                                                Classes="layout-cell output-cell">
                                                                            <TextBlock Text="输出区"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center"/>
                                                                        </Border>
                                                                    </Grid>
                                                                </Grid>
                                                            </Border>
                                                        </RadioButton>

                                                        <RadioButton Grid.Column="1"
                                                                     Classes="layout-option"
                                                                     GroupName="RunningLayoutOptions"
                                                                     IsChecked="{Binding IsRunningTwoColumnLayoutSelected}">
                                                            <Border Classes="layout-preview">
                                                                <Grid ColumnDefinitions="*,*"
                                                                      ColumnSpacing="4">
                                                                    <Border Classes="layout-cell video-cell">
                                                                        <TextBlock Text="视频源"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <Border Grid.Column="1"
                                                                            Classes="layout-cell output-cell">
                                                                        <TextBlock Text="输出区"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </RadioButton>

                                                        <RadioButton Grid.Column="2"
                                                                     Classes="layout-option"
                                                                     GroupName="RunningLayoutOptions"
                                                                     IsChecked="{Binding IsRunningOneColumnLayoutSelected}">
                                                            <Border Classes="layout-preview">
                                                                <Border Classes="layout-cell output-cell">
                                                                    <TextBlock Text="输出区"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                            </Border>
                                                        </RadioButton>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Classes="tab-layer-3"
                             Header="功能中心">
                        <ScrollViewer Classes="settings-scroll"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Classes="settings-page">
                                <Border Classes="settings-card">
                                    <StackPanel Spacing="12">
                                        <TextBlock Classes="card-title"
                                                   Text="远程运行"/>
                                        <Grid ColumnDefinitions="*,*"
                                              ColumnSpacing="10">
                                            <Button Content="远程运行"
                                                    Command="{Binding RemoteRunCommand}"
                                                    HorizontalAlignment="Stretch"/>
                                            <Button Grid.Column="1"
                                                    Content="远程停止"
                                                    Command="{Binding RemoteStopCommand}"
                                                    HorizontalAlignment="Stretch"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Classes="settings-card">
                                    <StackPanel Spacing="12">
                                        <TextBlock Classes="card-title"
                                                   Text="编译烧录"/>
                                        <Grid ColumnDefinitions="*,*"
                                              ColumnSpacing="10">
                                            <Button Content="编译烧录"
                                                    Command="{Binding CompileFlashCommand}"
                                                    HorizontalAlignment="Stretch"/>
                                            <Button Grid.Column="1"
                                                    Content="清除烧录"
                                                    Command="{Binding ClearFlashCommand}"
                                                    HorizontalAlignment="Stretch"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Classes="settings-card">
                                    <StackPanel Spacing="12">
                                        <TextBlock Classes="card-title"
                                                   Text="固件"/>
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="10">
                                            <ComboBox ItemsSource="{Binding FirmwareOptions}"
                                                      SelectedItem="{Binding SelectedFirmware}"
                                                      HorizontalAlignment="Stretch"/>
                                            <Button Grid.Column="1"
                                                    Content="生成"
                                                    Command="{Binding GenerateFirmwareCommand}"
                                                    MinWidth="96"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Classes="settings-card">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="card-title"
                                                       Text="蓝牙手柄设置"/>
                                            <TextBlock Classes="setting-caption"
                                                       Text="ESP32 手柄参数配置"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="配置"
                                                Command="{Binding OpenESPConfigCommand}"
                                                MinWidth="96"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Classes="settings-card">
                                    <StackPanel Spacing="12">
                                        <TextBlock Classes="card-title"
                                                   Text="画图"/>
                                        <Grid ColumnDefinitions="*,*"
                                              ColumnSpacing="10">
                                            <Button Content="喷射战士"
                                                    HorizontalAlignment="Stretch"/>
                                            <Button Grid.Column="1"
                                                    Content="自由画板"
                                                    HorizontalAlignment="Stretch"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- 第二列与第三列之间的拖拽分割线 -->
            <GridSplitter Grid.Column="2"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource WorkbenchBorderBrush}"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- 第三列：监视器（上） + 日志（下） -->
            <Grid Grid.Column="3" RowDefinitions="*,*">

                <!-- 第三列上半部分：监视器 -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource WorkbenchBorderBrush}"
                        BorderThickness="0,0,0,1"
                        DoubleTapped="MonitorArea_DoubleTapped">
                    <Grid>
                        <ContentControl Content="{Binding MonitorView}"
                                        IsVisible="{Binding IsMonitorVisible}" />
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="8"
                                Classes="flat-link"
                                Content="{Binding MonitorVisibilityButtonText}"
                                Command="{Binding ToggleMonitorVisibilityCommand}"/>
                    </Grid>
                </Border>

                <!-- 第三列下半部分：日志输出 -->
                <Grid Grid.Row="1" RowDefinitions="34,*">
                    <Grid Grid.Row="0"
                          ColumnDefinitions="*,Auto,34"
                          Background="{DynamicResource WorkbenchPanelBrush}">
                        <TextBlock Text="输出窗口"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource WorkbenchMutedTextBrush}"
                                   FontSize="12"/>
                        <TextBlock Grid.Column="1"
                                   Text="调试模式"
                                   Margin="0,0,4,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource WorkbenchMutedTextBrush}"
                                   FontSize="12"/>
                        <ToggleButton Grid.Column="2"
                                      Classes="debug-switch"
                                      IsChecked="{Binding ShowDebugInfo}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <TextBox Classes="log-output"
                                Text="{Binding LogOutput}"
                                Padding="10,30,10,10"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                behaviors:AutoScrollBehavior.IsEnabled="True"/>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Classes="flat-link"
                                Content="清空输出 ↻"
                                Foreground="{DynamicResource WorkbenchAmberBrush}"
                                Command="{Binding ClearLogCommand}"
                                Margin="0,6,12,0"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- 下部模块操作区 -->
        <Border Grid.Row="1"
               Padding="10"
               Background="{DynamicResource WorkbenchPanelBrush}"
               BorderBrush="{DynamicResource WorkbenchBorderBrush}"
               BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,*,*,*"
                 HorizontalAlignment="Stretch">

                <!-- 第一个模块：单片机连接 -->
                <GroupBox Grid.Column="0"
                          Margin="5"
                          Padding="10">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="单片机连接" FontWeight="Bold"/>
                            <TextBlock Text="{Binding NintendoSwitchStatus}"
                                       FontWeight="Bold"
                                       Foreground="{Binding IsNintendoSwitchConnected, Converter={StaticResource BoolToGreenBrush}}"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel Orientation="Vertical" Spacing="10">
                        <ComboBox ItemsSource="{Binding SerialPortOptions}"
                                  SelectedItem="{Binding SelectedSerialPort}"
                                  HorizontalAlignment="Stretch"
                                  behaviors:DropDownRefreshBehavior.RefreshCommand="{Binding RefreshSerialPortsCommand}"/>
                        <Grid ColumnDefinitions="*,*">
                            <Button Grid.Column="0"
                                    Content="{Binding NintendoSwitchButtonText}"
                                    Command="{Binding ConnectNintendoSwitchCommand}"
                                    IsEnabled="{Binding !IsConnectingNintendoSwitch}"
                                    Margin="0,0,5,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="自动连接"
                                    Command="{Binding AutoConnectNintendoSwitchCommand}"
                                    IsEnabled="{Binding !IsConnectingNintendoSwitch}"
                                    Classes="outline-accent"
                                    Margin="5,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- 第二个模块：视频源 -->
                <GroupBox Grid.Column="1"
                          Margin="5"
                          Padding="10">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="视频源" FontWeight="Bold"/>
                            <TextBlock Text="{Binding CaptureSourceStatus}"
                                       FontWeight="Bold"
                                       Foreground="{Binding IsCaptureSourceConnected, Converter={StaticResource BoolToGreenBrush}}"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel Orientation="Vertical" Spacing="10">
                        <ComboBox ItemsSource="{Binding CaptureSourceOptions}"
                                  SelectedItem="{Binding SelectedCaptureSource}"
                                  HorizontalAlignment="Stretch"
                                  behaviors:DropDownRefreshBehavior.RefreshCommand="{Binding RefreshCaptureSourcesCommand}"/>
                        <Button Content="{Binding CaptureSourceButtonText}"
                                Command="{Binding ConnectCaptureSourceCommand}"
                                IsEnabled="{Binding !IsConnectingCaptureSource}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </GroupBox>

                <!-- 第三个模块：虚拟手柄 -->
                <GroupBox Grid.Column="2"
                          Margin="5"
                          Padding="10">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="虚拟手柄" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ControlSourceStatus}"
                                       FontWeight="Bold"
                                       Foreground="{Binding IsControllerConnected, Converter={StaticResource BoolToGreenBrush}}"/>
                        </StackPanel>
                    </GroupBox.Header>
                    <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="*,Auto,Auto"
                          RowSpacing="10"
                          ColumnSpacing="10">
                        <!-- 第一排：下拉框 + 开启映射按钮 -->
                        <Grid Grid.Row="0"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              ColumnDefinitions="*">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding ControlSourceOptions}"
                                      SelectedItem="{Binding SelectedControlSource}"
                                      HorizontalAlignment="Stretch"
                                      behaviors:DropDownRefreshBehavior.RefreshCommand="{Binding RefreshControlSourcesCommand}"/>
                        </Grid>
                        <Button Grid.Row="0"
                                Grid.Column="2"
                                Content="{Binding ControllerButtonText}"
                                Command="{Binding ConnectControllerCommand}"
                                IsEnabled="{Binding !IsConnectingController}"
                                Padding="8,4"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Stretch"/>
                        <!-- 第二排：录制脚本 + 停止录制 + 按键映射 -->
                        <Button Grid.Row="1"
                                Grid.Column="0"
                                Content="录制脚本"
                                Command="{Binding StartRecordCommand}"
                                Padding="12,4"
                                HorizontalAlignment="Left"
                                HorizontalContentAlignment="Center"/>
                        <Button Grid.Row="1"
                                Grid.Column="1"
                                Content="停止录制"
                                Command="{Binding StopRecordCommand}"
                                Padding="12,4"
                                HorizontalContentAlignment="Center"/>
                        <Button Grid.Row="1"
                                Grid.Column="2"
                                Content="按键映射"
                                Command="{Binding EditKeyMappingCommand}"
                                CommandParameter="{Binding $parent[Window]}"
                                IsEnabled="{Binding IsEditKeyMappingEnabled}"
                                Padding="12,4"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                    </Grid>
                </GroupBox>

                <!-- 运行脚本按钮（不变） -->
                <Border Grid.Column="3"
                        Margin="5"
                        Padding="10"
                        Background="{DynamicResource WorkbenchPanelBrush}">
                    <Grid>
                        <StackPanel Orientation="Vertical"
                                    HorizontalAlignment="Stretch"
                                    Spacing="8">
                            <TextBlock Text="{Binding RunTimeDisplay}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       FontFamily="Consolas"
                                       Foreground="{DynamicResource WorkbenchMutedTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <Button Content="{Binding RunButtonText}"
                                    Command="{Binding RunScriptCommand}"
                                    Classes="run-button"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource WorkbenchOnAccentBrush}"
                                    Background="{Binding IsRunning, Converter={StaticResource BoolToRunColor}}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        </Grid>
    </DockPanel>
</Window>
