<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tag="using:EasyCon2.Avalonia.Core.TagEditor"
        x:Class="EasyCon2.Avalonia.Views.TagEditorWindow"
        Title="标签编辑器"
        Width="880"
        Height="600"
        MinWidth="860"
        MinHeight="600"
        Icon="/Assets/favicon.ico">

    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="8">
            <Button Content="保存" Click="OnSave" IsDefault="True" MinWidth="80"/>
            <Button Content="关闭" Click="OnClose" IsCancel="True" MinWidth="80"/>
        </StackPanel>
        <tag:TagEditorView x:Name="TagEditor" />
    </DockPanel>
</Window>
