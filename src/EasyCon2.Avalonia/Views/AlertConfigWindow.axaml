<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:alert="using:EasyCon2.Avalonia.Core.AlertConfig"
        x:Class="EasyCon2.Avalonia.Views.AlertConfigWindow"
        Title="推送设置"
        Width="760"
        Height="760"
        MinWidth="620"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Icon="/Resources/Images/favicon.ico">
    <alert:AlertConfigControl x:Name="AlertConfig"/>
</Window>
