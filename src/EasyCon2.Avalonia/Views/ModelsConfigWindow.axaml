<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:modelsConfig="using:EasyCon2.Avalonia.Core.ModelsConfig"
        x:Class="EasyCon2.Avalonia.Views.ModelsConfigWindow"
        Title="模型配置"
        Width="820"
        Height="720"
        MinWidth="640"
        MinHeight="500"
        WindowStartupLocation="CenterOwner">
    <modelsConfig:ModelsConfigControl x:Name="ModelsConfig"/>
</Window>
