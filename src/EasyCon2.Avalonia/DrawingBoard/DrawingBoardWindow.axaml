<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EasyCon2.Avalonia.DrawingBoard"
        xmlns:conv="using:EasyCon2.Avalonia.Converters"
        xmlns:loc="using:EasyCon2.Avalonia.Markup"
        xmlns:behaviors="using:EasyCon2.Avalonia.Behaviors"
        x:Class="EasyCon2.Avalonia.DrawingBoard.DrawingBoardWindow"
        x:DataType="vm:DrawingBoardViewModel"
        Title="{loc:Translate Text.DrawingBoard.Title}"
        Width="900"
        Height="560"
        MinWidth="480"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        behaviors:FileDropBehavior.Command="{Binding DropPictureCommand}">

    <!-- 布局：预览图（绘制中显示进度与光标）/ 绘制区域与坐标 / 参数与按钮 / 进度 / 提示与耗时。
         窗口可缩放：预览占据剩余空间并随窗口等比放大缩小；其余控件保持原尺寸，窄时参数分组自动换行 -->
    <Grid Margin="16" RowDefinitions="*,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
        <!-- 预览的逻辑尺寸固定为 822×282，由 Viewbox 等比缩放：点击、拖动坐标按 Image 自身坐标系换算，不受缩放影响 -->
        <Viewbox Stretch="Uniform">
            <Border x:Name="PictureFrame"
                    Background="Transparent"
                    BorderBrush="{DynamicResource WorkbenchControlBorderBrush}"
                    BorderThickness="1">
                <Image x:Name="PictureBox"
                       Width="822"
                       Height="282"
                       Stretch="Fill"
                       Source="{Binding DisplayImage, Converter={x:Static conv:PixelImageToBitmapConverter.Instance}}"/>
            </Border>
        </Viewbox>

        <!-- 绘制区域：默认整张画布；高级选项下在预览上拖动框选 -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
            <CheckBox Content="{loc:Translate Text.DrawingBoard.SelectRegion}"
                      ToolTip.Tip="{loc:Translate Text.DrawingBoard.SelectRegionTip}"
                      IsChecked="{Binding SelectRegion}"
                      VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Content="{loc:Translate Text.DrawingBoard.ResetRegion}"
                    Command="{Binding ResetRegionCommand}"
                    IsVisible="{Binding SelectRegion}"
                    VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding RegionText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="{Binding CurPosText}" VerticalAlignment="Center"/>
        </Grid>

        <WrapPanel Grid.Row="2" ItemSpacing="16" LineSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{loc:Translate Text.DrawingBoard.LoadPicture}"
                        Command="{Binding LoadPictureCommand}"
                        ToolTip.Tip="{loc:Translate Text.DrawingBoard.LoadPictureTip}"
                        MinWidth="110"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"/>
                <!-- 保存预览中的图片：默认二值化结果，勾选"显示原图"时为适配后的原图 -->
                <Button Content="{loc:Translate Text.DrawingBoard.SavePicture}"
                        Command="{Binding SavePictureCommand}"
                        ToolTip.Tip="{loc:Translate Text.DrawingBoard.SavePictureTip}"
                        MinWidth="110"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"/>
            </StackPanel>

            <!-- 图片处理：适配方式把任意尺寸的图放进 320×120；阈值决定哪些点算墨点，预览显示的就是将要画的结果 -->
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{loc:Translate Text.DrawingBoard.Fit}" VerticalAlignment="Center"/>
                <ComboBox SelectedIndex="{Binding FitModeIndex}" VerticalAlignment="Center">
                    <ComboBoxItem Content="{loc:Translate Text.DrawingBoard.FitContain}"/>
                    <ComboBoxItem Content="{loc:Translate Text.DrawingBoard.FitCover}"/>
                    <ComboBoxItem Content="{loc:Translate Text.DrawingBoard.FitStretch}"/>
                </ComboBox>
                <TextBlock Text="{Binding SourceSizeText}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 等比裁切的取景调整：任意角度旋转、缩放、取景位置；只在等比裁切时显示 -->
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsCoverMode}">
                <TextBlock Text="{loc:Translate Text.DrawingBoard.CoverAngle}" VerticalAlignment="Center"/>
                <Slider Width="110" Minimum="-180" Maximum="180" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding CoverAngle}" VerticalAlignment="Center"/>
                <TextBlock MinWidth="40" Text="{Binding CoverAngle, StringFormat={}{0:0}°}" VerticalAlignment="Center"/>
                <TextBlock Text="{loc:Translate Text.DrawingBoard.CoverZoom}" VerticalAlignment="Center"/>
                <Slider Width="110" Minimum="100" Maximum="400" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding CoverZoomPercent}" VerticalAlignment="Center"/>
                <TextBlock MinWidth="40" Text="{Binding CoverZoomPercent, StringFormat={}{0:0}%}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsCoverMode}">
                <TextBlock Text="{loc:Translate Text.DrawingBoard.CoverPanX}" VerticalAlignment="Center"/>
                <Slider Width="110" Minimum="-100" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding CoverPanX}" VerticalAlignment="Center"/>
                <TextBlock Text="{loc:Translate Text.DrawingBoard.CoverPanY}" VerticalAlignment="Center"/>
                <Slider Width="110" Minimum="-100" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding CoverPanY}" VerticalAlignment="Center"/>
                <Button Content="{loc:Translate Text.DrawingBoard.CoverReset}"
                        Command="{Binding ResetCoverCommand}"
                        VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 原图方向：先顺时针旋转，再按旋转后的方向翻转 -->
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{loc:Translate Text.DrawingBoard.Rotate}" VerticalAlignment="Center"/>
                <ComboBox SelectedIndex="{Binding RotationIndex}"
                          ToolTip.Tip="{loc:Translate Text.DrawingBoard.RotateTip}"
                          VerticalAlignment="Center">
                    <ComboBoxItem Content="0°"/>
                    <ComboBoxItem Content="90°"/>
                    <ComboBoxItem Content="180°"/>
                    <ComboBoxItem Content="270°"/>
                </ComboBox>
                <CheckBox Content="{loc:Translate Text.DrawingBoard.FlipHorizontal}"
                          IsChecked="{Binding FlipHorizontal}"
                          VerticalAlignment="Center"/>
                <CheckBox Content="{loc:Translate Text.DrawingBoard.FlipVertical}"
                          IsChecked="{Binding FlipVertical}"
                          VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 抖动：顺序与 DitherMode 一致 -->
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        ToolTip.Tip="{loc:Translate Text.DrawingBoard.DitherTip}">
                <TextBlock Text="{loc:Translate Text.DrawingBoard.Dither}" VerticalAlignment="Center"/>
                <ComboBox SelectedIndex="{Binding DitherModeIndex}" VerticalAlignment="Center">
                    <ComboBoxItem Content="{loc:Translate Text.DrawingBoard.DitherNone}"/>
                    <ComboBoxItem Content="{loc:Translate Text.DrawingBoard.DitherFloydSteinberg}"/>
                    <ComboBoxItem Content="{loc:Translate Text.DrawingBoard.DitherFloydSteinbergSerpentine}"/>
                    <ComboBoxItem Content="{loc:Translate Text.DrawingBoard.DitherAtkinson}"/>
                    <ComboBoxItem Content="{loc:Translate Text.DrawingBoard.DitherJarvisJudiceNinke}"/>
                    <ComboBoxItem Content="{loc:Translate Text.DrawingBoard.DitherStucki}"/>
                    <ComboBoxItem Content="{loc:Translate Text.DrawingBoard.DitherBayer}"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{loc:Translate Text.DrawingBoard.Threshold}" VerticalAlignment="Center"/>
                <Slider Width="120"
                        Minimum="0"
                        Maximum="100"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Value="{Binding ThresholdPercent}"
                        VerticalAlignment="Center"/>
                <TextBlock MinWidth="36"
                           Text="{Binding ThresholdPercent, StringFormat={}{0}%}"
                           VerticalAlignment="Center"/>
                <CheckBox Content="{loc:Translate Text.DrawingBoard.Reverse}"
                          IsChecked="{Binding Reverse}"
                          VerticalAlignment="Center"/>
                <CheckBox Content="{loc:Translate Text.DrawingBoard.ShowOriginal}"
                          IsChecked="{Binding ShowOriginal}"
                          VerticalAlignment="Center"/>
            </StackPanel>

            <Grid ColumnDefinitions="Auto,64" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6">
                <TextBlock Text="{loc:Translate Text.DrawingBoard.Duration}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding DurationText}"/>
                <TextBlock Grid.Row="1" Text="{loc:Translate Text.DrawingBoard.Delay}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DelayText}"/>
            </Grid>

            <CheckBox Content="{loc:Translate Text.DrawingBoard.EraserMode}"
                      ToolTip.Tip="{loc:Translate Text.DrawingBoard.EraserHelp}"
                      IsChecked="{Binding EraserMode}"
                      VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{loc:Translate Text.DrawingBoard.Start}"
                        Command="{Binding StartCommand}"
                        IsEnabled="{Binding IsStartEnabled}"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Center"/>
                <Button Content="{Binding PauseButtonText}"
                        Command="{Binding TogglePauseCommand}"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Center"/>
                <Button Content="{loc:Translate Text.DrawingBoard.Stop}"
                        Command="{Binding StopCommand}"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Center"/>
            </StackPanel>
        </WrapPanel>

        <!-- 橡皮擦模式的准备步骤：勾选后才显示 -->
        <TextBlock Grid.Row="3"
                   IsVisible="{Binding EraserMode}"
                   Text="{loc:Translate Text.DrawingBoard.EraserHelp}"
                   TextWrapping="Wrap"/>

        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <ProgressBar Minimum="0"
                         Maximum="100"
                         Value="{Binding ProgressValue}"
                         VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       MinWidth="200"
                       MaxWidth="420"
                       Text="{Binding ProgressText}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="5" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <TextBlock Text="{loc:Translate Text.DrawingBoard.Tip}"
                       TextWrapping="Wrap"/>
            <!-- 估算耗时随图片与参数自动更新 -->
            <TextBlock Grid.Column="1" Text="{Binding EstimateText}"/>
        </Grid>
    </Grid>
</Window>