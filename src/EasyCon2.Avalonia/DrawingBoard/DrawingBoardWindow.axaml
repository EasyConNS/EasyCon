<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EasyCon2.Avalonia.DrawingBoard"
        xmlns:conv="using:EasyCon2.Avalonia.Converters"
        xmlns:loc="using:EasyCon2.Avalonia.Markup"
        x:Class="EasyCon2.Avalonia.DrawingBoard.DrawingBoardWindow"
        x:DataType="vm:DrawingBoardViewModel"
        Title="{loc:Translate Text.DrawingBoard.Title}"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

    <!-- 布局对照 1.6.3 WinForms 版 DrawingBoard：预览图 / 坐标说明 / 参数与按钮 / 进度（新增）/ 提示与耗时 -->
    <StackPanel Margin="16" Spacing="8">
        <Border x:Name="PictureFrame"
                Background="Transparent"
                BorderBrush="{DynamicResource WorkbenchControlBorderBrush}"
                BorderThickness="1"
                HorizontalAlignment="Left">
            <Image x:Name="PictureBox"
                   Width="822"
                   Height="282"
                   Stretch="Fill"
                   Source="{Binding Picture, Converter={x:Static conv:PixelImageToBitmapConverter.Instance}}"/>
        </Border>

        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{loc:Translate Text.DrawingBoard.Region}"/>
            <TextBlock Grid.Column="1" Text="{Binding CurPosText}"/>
        </Grid>

        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="16">
            <Button Content="{loc:Translate Text.DrawingBoard.LoadPicture}"
                    Command="{Binding LoadPictureCommand}"
                    MinWidth="110"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    HorizontalContentAlignment="Center"/>

            <CheckBox Grid.Column="1"
                      Content="{loc:Translate Text.DrawingBoard.Reverse}"
                      IsChecked="{Binding Reverse}"
                      VerticalAlignment="Bottom"/>

            <Grid Grid.Column="2" ColumnDefinitions="Auto,64" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6">
                <TextBlock Text="{loc:Translate Text.DrawingBoard.StartCol}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding StartPosXText}"/>
                <TextBlock Grid.Row="1" Text="{loc:Translate Text.DrawingBoard.StartRow}" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StartPosYText}"/>
            </Grid>

            <Grid Grid.Column="3" ColumnDefinitions="Auto,64" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6">
                <TextBlock Text="{loc:Translate Text.DrawingBoard.ColCount}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding WidthText}"/>
                <TextBlock Grid.Row="1" Text="{loc:Translate Text.DrawingBoard.RowCount}" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HeightText}"/>
            </Grid>

            <Grid Grid.Column="4" ColumnDefinitions="Auto,64" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6">
                <TextBlock Text="{loc:Translate Text.DrawingBoard.Duration}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding DurationText}"/>
                <TextBlock Grid.Row="1" Text="{loc:Translate Text.DrawingBoard.Delay}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DelayText}"/>
            </Grid>

            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="8">
                <Button Content="{loc:Translate Text.DrawingBoard.Start}"
                        Command="{Binding StartCommand}"
                        IsEnabled="{Binding IsStartEnabled}"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Center"/>
                <Button Content="{loc:Translate Text.DrawingBoard.Stop}"
                        Command="{Binding StopCommand}"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Center"/>
                <Button Content="{loc:Translate Text.DrawingBoard.Estimate}"
                        Command="{Binding EvaluateCommand}"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <ProgressBar Minimum="0"
                         Maximum="100"
                         Value="{Binding ProgressValue}"
                         VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1"
                       MinWidth="260"
                       Text="{Binding ProgressText}"
                       VerticalAlignment="Center"/>
        </Grid>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <TextBlock Text="{loc:Translate Text.DrawingBoard.Tip}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="1" Text="{Binding EvaluateText}"/>
        </Grid>
    </StackPanel>
</Window>