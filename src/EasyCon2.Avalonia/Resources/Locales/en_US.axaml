    <!-- Audio label editor -->
    <x:String x:Key="Text.AudioLabel.Title">Audio labels</x:String>
    <x:String x:Key="Text.AudioLabel.Intro">Record a new sound or capture recent audio, then select, preview and save it. Game audio keeps capturing while you edit.</x:String>
    <x:String x:Key="Text.AudioLabel.Record">Start recording</x:String>
    <x:String x:Key="Text.AudioLabel.StopRecording">Stop recording</x:String>
    <x:String x:Key="Text.AudioLabel.RecordingSummary">Recorded {0:F1} / {1:F1} s</x:String>
    <x:String x:Key="Text.AudioLabel.Recording">Recording new audio. Stop when ready; recording ends automatically at the displayed limit.</x:String>
    <x:String x:Key="Text.AudioLabel.Recorded">Recorded {0:F3} seconds. Select the complete sound and preview it.</x:String>
    <x:String x:Key="Text.AudioLabel.RecordedLimit">Recording limit reached. Kept the first {0:F3} seconds from the start. Select the complete sound and preview it.</x:String>
    <x:String x:Key="Text.AudioLabel.Capture">Capture last 10 seconds</x:String>
    <x:String x:Key="Text.AudioLabel.Open">Open WAV / audio label</x:String>
    <x:String x:Key="Text.AudioLabel.FileFilter">WAV audio / audio label</x:String>
    <x:String x:Key="Text.AudioLabel.WaveformHint">Click or drag the red cursor to seek. Drag elsewhere to select a clip, or drag either boundary to adjust it.</x:String>
    <x:String x:Key="Text.AudioLabel.Empty">Capture game audio or open an existing clip</x:String>
    <x:String x:Key="Text.AudioLabel.Start">Start time (seconds)</x:String>
    <x:String x:Key="Text.AudioLabel.End">End time (seconds)</x:String>
    <x:String x:Key="Text.AudioLabel.SelectAll">Select all</x:String>
    <x:String x:Key="Text.AudioLabel.Play">Preview selection</x:String>
    <x:String x:Key="Text.AudioLabel.Pause">Pause preview</x:String>
    <x:String x:Key="Text.AudioLabel.Resume">Resume preview</x:String>
    <x:String x:Key="Text.AudioLabel.SpaceHint">Space: play / pause</x:String>
    <x:String x:Key="Text.AudioLabel.Stop">Stop preview</x:String>
    <x:String x:Key="Text.AudioLabel.PreviewUnsupported">Preview is unavailable on this platform. Existing audio can still be edited and saved.</x:String>
    <x:String x:Key="Text.AudioLabel.Name">Label name</x:String>
    <x:String x:Key="Text.AudioLabel.NamePlaceholder">For example: Shiny sound</x:String>
    <x:String x:Key="Text.AudioLabel.Save">Save selection as label</x:String>
    <x:String x:Key="Text.AudioLabel.SaveHint">Saved script: labels go in its audiolabel folder. Otherwise, choose the script folder; audiolabel is created automatically.</x:String>
    <x:String x:Key="Text.AudioLabel.InvalidName">Use a valid file name without paths, reserved characters, or trailing spaces or periods.</x:String>
    <x:String x:Key="Text.AudioLabel.Ready">Connect game audio to record or capture the last 10 seconds. Recordings last up to 15 seconds, less at high sample rates or channel counts.</x:String>
    <x:String x:Key="Text.AudioLabel.NoHistory">No recent audio. Connect an audio source and check that data is arriving. Your current selection is kept.</x:String>
    <x:String x:Key="Text.AudioLabel.Captured">Captured the last {0:F3} seconds. Select the complete sound and preview it.</x:String>
    <x:String x:Key="Text.AudioLabel.Loaded">Audio opened. Adjust the selection and save it as a new label.</x:String>
    <x:String x:Key="Text.AudioLabel.ClipSummary">Duration {0:F3} s · {1:N0} Hz · {2} channels · {3} bit</x:String>
    <x:String x:Key="Text.AudioLabel.SelectionSummary">Selection {0:F3} → {1:F3} s · Length {2:F3} s</x:String>
    <x:String x:Key="Text.AudioLabel.PlaybackSummary">Position {0:F3} s / Total {1:F3} s</x:String>
    <x:String x:Key="Text.AudioLabel.Playing">Previewing through the default audio output. The red cursor shows the playback position.</x:String>
    <x:String x:Key="Text.AudioLabel.Played">Preview finished.</x:String>
    <x:String x:Key="Text.AudioLabel.Paused">Preview paused. Click or drag the red cursor to resume from a new position without changing the saved selection.</x:String>
    <x:String x:Key="Text.AudioLabel.Stopped">Preview stopped; the cursor stays here. Next preview starts at the selection start, or click the waveform to seek.</x:String>
    <x:String x:Key="Text.AudioLabel.SaveFolder">Choose the script folder (audiolabel is created automatically)</x:String>
    <x:String x:Key="Text.AudioLabel.AlreadyExists">A label with this name already exists: {0}. Choose another name and save again.</x:String>
    <x:String x:Key="Text.AudioLabel.Saved">Label saved: {0}</x:String>
    <x:String x:Key="Text.AudioLabel.Error">Operation failed: {0}</x:String>
    <x:String x:Key="Text.AudioMatch.Title">Audio match test</x:String>
    <x:String x:Key="Text.AudioMatch.Intro">Open a saved audio label, start listening, then trigger the target sound in your game to inspect scores and hits.</x:String>
    <x:String x:Key="Text.AudioMatch.NoTemplate">No label selected · Use a sound lasting 0.15–10 seconds</x:String>
    <x:String x:Key="Text.AudioMatch.TemplateSummary">{0} · {1:F3} s</x:String>
    <x:String x:Key="Text.AudioMatch.Start">Start listening</x:String>
    <x:String x:Key="Text.AudioMatch.Stop">Stop listening</x:String>
    <x:String x:Key="Text.AudioMatch.Threshold">Match threshold</x:String>
    <x:String x:Key="Text.AudioMatch.Cooldown">Hit interval (seconds)</x:String>
    <x:String x:Key="Text.AudioMatch.CurrentScore">Current match score</x:String>
    <x:String x:Key="Text.AudioMatch.PeakScore">Session peak</x:String>
    <x:String x:Key="Text.AudioMatch.HitSummary">{0} hits · Latest 100 shown</x:String>
    <x:String x:Key="Text.AudioMatch.Clear">Clear results</x:String>
    <x:String x:Key="Text.AudioMatch.Time">Detection time</x:String>
    <x:String x:Key="Text.AudioMatch.HitScore">Hit score</x:String>
    <x:String x:Key="Text.AudioMatch.Ready">Open label.json from an audio label folder, or open a WAV sound.</x:String>
    <x:String x:Key="Text.AudioMatch.Loaded">Label loaded. Connect game audio, then start listening.</x:String>
    <x:String x:Key="Text.AudioMatch.InvalidDuration">Use a label lasting 0.15–10 seconds. Trim the complete target sound in the audio label editor.</x:String>
    <x:String x:Key="Text.AudioMatch.NoSignal">The label is silent, too quiet, or has no usable spectrum. Capture a clear target sound.</x:String>
    <x:String x:Key="Text.AudioMatch.WaitingForAudio">Waiting for new audio. Connect a game audio input in the main window.</x:String>
    <x:String x:Key="Text.AudioMatch.WarmingUp">Collecting enough audio for a complete match…</x:String>
    <x:String x:Key="Text.AudioMatch.Listening">Matching. Threshold and hit interval changes apply to subsequent audio.</x:String>
    <x:String x:Key="Text.AudioMatch.Interrupted">Audio stalled or processing fell behind. Old data was cleared; waiting for continuous audio.</x:String>
    <x:String x:Key="Text.AudioMatch.Disconnected">Audio input is disconnected. Matching will warm up again after reconnection.</x:String>
    <x:String x:Key="Text.AudioMatch.InvalidAudio">Invalid audio received. Old data was cleared. Check the input device and format.</x:String>
    <x:String x:Key="Text.AudioMatch.Stopped">Listening stopped; hit records are kept. Starting again clears the session results.</x:String>
    <x:String x:Key="Text.AudioMatch.Hint">Similarity scores are integers from 0 to 100, rounded down, matching ECS AUDIO_SCORE. Start at 85, test both target and ordinary game sounds, then use your calibrated threshold in the script's IF.</x:String>
</ResourceDictionary>