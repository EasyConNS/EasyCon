    <x:String x:Key="Text.DrawingBoard.Title">Drawing Board</x:String>
    <x:String x:Key="Text.DrawingBoard.Region">Canvas coordinates: top-left 0,0, bottom-right 319,119</x:String>
    <x:String x:Key="Text.DrawingBoard.LoadPicture">Load Picture</x:String>
    <x:String x:Key="Text.DrawingBoard.LoadPictureTip">Supports PNG, JPG, BMP, GIF, WebP, ICO and WBMP; you can also drop a picture onto the window</x:String>
    <x:String x:Key="Text.DrawingBoard.ImageFilter">Images</x:String>
    <x:String x:Key="Text.DrawingBoard.SavePicture">Save Picture</x:String>
    <x:String x:Key="Text.DrawingBoard.SavePictureTip">Save the 320×120 preview as PNG: by default the black-and-white result (what will be drawn); with “Show original” checked, the rotated and fitted original</x:String>
    <x:String x:Key="Text.DrawingBoard.Saved">Picture saved: {0}</x:String>
    <x:String x:Key="Text.DrawingBoard.SaveFailed">Failed to save the picture</x:String>
    <x:String x:Key="Text.DrawingBoard.Reverse">Invert</x:String>
    <x:String x:Key="Text.DrawingBoard.Threshold">Threshold</x:String>
    <x:String x:Key="Text.DrawingBoard.ShowOriginal">Show original</x:String>
    <x:String x:Key="Text.DrawingBoard.Dither">Dither</x:String>
    <x:String x:Key="Text.DrawingBoard.DitherTip">Represents shades with dot density. Better for grayscale photos, but dots are scattered and drawing takes longer. Atkinson uses the fewest dots and draws fastest; serpentine reduces diagonal streaks; Bayer gives a regular pattern.</x:String>
    <x:String x:Key="Text.DrawingBoard.DitherNone">Off</x:String>
    <x:String x:Key="Text.DrawingBoard.DitherFloydSteinberg">Floyd–Steinberg</x:String>
    <x:String x:Key="Text.DrawingBoard.DitherFloydSteinbergSerpentine">Floyd–Steinberg (serpentine)</x:String>
    <x:String x:Key="Text.DrawingBoard.DitherAtkinson">Atkinson (fewer dots, more contrast)</x:String>
    <x:String x:Key="Text.DrawingBoard.DitherJarvisJudiceNinke">Jarvis–Judice–Ninke (smoothest)</x:String>
    <x:String x:Key="Text.DrawingBoard.DitherStucki">Stucki</x:String>
    <x:String x:Key="Text.DrawingBoard.DitherBayer">Bayer ordered (regular grid)</x:String>
    <x:String x:Key="Text.DrawingBoard.StartCol">Start col</x:String>
    <x:String x:Key="Text.DrawingBoard.StartRow">Start row</x:String>
    <x:String x:Key="Text.DrawingBoard.ColCount">Columns</x:String>
    <x:String x:Key="Text.DrawingBoard.RowCount">Rows</x:String>
    <x:String x:Key="Text.DrawingBoard.Duration">Key hold</x:String>
    <x:String x:Key="Text.DrawingBoard.Delay">Delay</x:String>
    <x:String x:Key="Text.DrawingBoard.Start">Start</x:String>
    <x:String x:Key="Text.DrawingBoard.Stop">Stop</x:String>
    <x:String x:Key="Text.DrawingBoard.EraserMode">Eraser mode (canvas pre-filled black)</x:String>
    <x:String x:Key="Text.DrawingBoard.EraserHelp">Eraser mode: before starting, fill the whole canvas black in the game with the largest brush, then pick the smallest brush and move the cursor to the top-left corner. The program holds B (eraser) to erase the blank parts of the picture; the result is the same as pen mode. Pictures that are mostly black need fewer points and usually finish faster; compare the estimate at the bottom right. Only points inside the drawing region are processed; the rest stays black.</x:String>
    <x:String x:Key="Text.DrawingBoard.Tip">Before starting, open the drawing screen, pick the smallest brush and move the cursor to the top-left corner. Drawing goes from top-left to bottom-right.</x:String>
    <x:String x:Key="Text.DrawingBoard.CurPosNone">Position: click the preview</x:String>
    <x:String x:Key="Text.DrawingBoard.CurPos">Position: {0},{1}</x:String>
    <x:String x:Key="Text.DrawingBoard.EstimateNone">Time:</x:String>
    <x:String x:Key="Text.DrawingBoard.EstimateInvalid">Time: invalid parameters</x:String>
    <x:String x:Key="Text.DrawingBoard.EstimateResult">Time: {0:0.00} min</x:String>
    <x:String x:Key="Text.DrawingBoard.LoadFailed">Failed to load the picture (supported: PNG, JPG, BMP, GIF, WebP, ICO, WBMP; convert HEIC, TIFF and others first)</x:String>
    <x:String x:Key="Text.DrawingBoard.Fit">Fit</x:String>
    <x:String x:Key="Text.DrawingBoard.FitContain">Fit (letterbox)</x:String>
    <x:String x:Key="Text.DrawingBoard.FitCover">Fill (crop)</x:String>
    <x:String x:Key="Text.DrawingBoard.FitStretch">Stretch</x:String>
    <x:String x:Key="Text.DrawingBoard.CoverAngle">Angle</x:String>
    <x:String x:Key="Text.DrawingBoard.CoverZoom">Zoom</x:String>
    <x:String x:Key="Text.DrawingBoard.CoverPanX">Horizontal</x:String>
    <x:String x:Key="Text.DrawingBoard.CoverPanY">Vertical</x:String>
    <x:String x:Key="Text.DrawingBoard.CoverReset">Reset framing</x:String>
    <x:String x:Key="Text.DrawingBoard.SourceSize">Source {0}×{1}</x:String>
    <x:String x:Key="Text.DrawingBoard.Rotate">Rotate</x:String>
    <x:String x:Key="Text.DrawingBoard.RotateTip">Rotate the picture clockwise; flips apply to the rotated picture</x:String>
    <x:String x:Key="Text.DrawingBoard.FlipHorizontal">Flip horizontally</x:String>
    <x:String x:Key="Text.DrawingBoard.FlipVertical">Flip vertically</x:String>
    <x:String x:Key="Text.DrawingBoard.NotConnected">Serial port not connected</x:String>
    <x:String x:Key="Text.DrawingBoard.NoPicture">No picture loaded</x:String>
    <x:String x:Key="Text.DrawingBoard.InvalidField">{0} must be an integer from {1} to {2}</x:String>
    <x:String x:Key="Text.DrawingBoard.Preparing">Preparing…</x:String>
    <x:String x:Key="Text.DrawingBoard.Progress">{0} · elapsed {1} · about {2} left</x:String>
