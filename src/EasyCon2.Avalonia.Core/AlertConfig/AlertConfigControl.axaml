<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EasyCon2.Avalonia.Core.AlertConfig"
             x:Class="EasyCon2.Avalonia.Core.AlertConfig.AlertConfigControl"
             x:DataType="vm:AlertConfigViewModel">

    <DockPanel Margin="16"
               Background="{DynamicResource WorkbenchWindowBrush}">
        <!-- Bottom buttons -->
        <Grid DockPanel.Dock="Bottom"
              RowDefinitions="Auto,Auto"
              ColumnDefinitions="Auto,*,Auto"
              Margin="0,12,0,0">
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        Spacing="8">
                <Button Content="添加配置"
                        IsEnabled="{Binding CanAdd}">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="PushPlus" Command="{Binding AddItemCommand}" CommandParameter="pushplus"/>
                            <MenuItem Header="Bark" Command="{Binding AddItemCommand}" CommandParameter="bark"/>
                            <MenuItem Header="自定义Webhook" Command="{Binding AddItemCommand}" CommandParameter="webhook"/>
                            <MenuItem Header="qq bot" Command="{Binding AddItemCommand}" CommandParameter="qq"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="3"
                       Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource WorkbenchDangerBrush}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       IsVisible="{Binding HasError}"/>
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Background="Transparent"
                        BorderThickness="0"
                        Padding="4,2"
                        Cursor="Hand"
                        Click="OnOpenFile">
                    <TextBlock Text="打开配置文件目录"
                               Foreground="{DynamicResource WorkbenchAccentBrush}"
                               TextDecorations="Underline"/>
                </Button>
                <Button Content="保存"
                        Click="OnSave"
                        IsEnabled="{Binding CanSave}"
                        IsDefault="True"/>
                <Button Content="取消"
                        Click="OnCancel"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>

        <!-- Hidden items hint -->
        <Border DockPanel.Dock="Bottom"
                IsVisible="{Binding HasHiddenItems}"
                Background="{DynamicResource WorkbenchOutlineAccentBackgroundBrush}"
                BorderBrush="{DynamicResource WorkbenchAccentBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource WorkbenchControlRadius}"
                Padding="8,4"
                Margin="0,8,0,0">
            <TextBlock>
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}还有 {0} 条配置未显示">
                        <Binding Path="HiddenCount"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </Border>

        <!-- Item list -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding VisibleItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AlertItemViewModel">
                        <vm:AlertItemView/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
