<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:qq="using:EasyCon2.Avalonia.Core.QQ"
             x:Class="EasyCon2.Avalonia.Core.QQ.QQNotificationEditor"
             x:DataType="qq:QQNotificationViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchDangerBrush}"/>
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="10">
        <WrapPanel Orientation="Horizontal">
            <Button Content="使用教程" Click="OnOpenGuide" Margin="0,0,12,4"/>
            <HyperlinkButton NavigateUri="{x:Static qq:QQGuideCatalog.PlatformUri}" Cursor="Hand"
                             AutomationProperties.Name="QQ 开放平台"
                             ToolTip.Tip="https://q.qq.com/#/apps" Margin="0,0,0,4">
                <Border BorderThickness="0,0,0,1" Padding="0,0,0,1"
                        BorderBrush="{DynamicResource WorkbenchAccentBrush}">
                    <TextBlock Text="QQ 开放平台 ↗" TextDecorations="{x:Null}"
                               Foreground="{DynamicResource WorkbenchAccentBrush}"/>
                </Border>
            </HyperlinkButton>
        </WrapPanel>
        <TextBlock Text="填写 QQ 机器人凭据，绑定接收方后发送图文测试。修改完成后，点击窗口底部的「保存」。"
                   TextWrapping="Wrap" Opacity="0.72"/>
        <TextBlock Text="AppID"/>
        <TextBox Text="{Binding AppId, Mode=TwoWay}" PlaceholderText="QQ 开放平台 AppID" IsEnabled="{Binding CanEdit}"/>
        <TextBlock Text="AppSecret"/>
        <TextBox Text="{Binding Secret, Mode=TwoWay}" PasswordChar="●" PlaceholderText="仅保存在当前会话，或使用记住密钥" IsEnabled="{Binding CanEdit}"/>
        <CheckBox Content="记住 AppSecret（Windows DPAPI 加密）"
                  IsChecked="{Binding RememberSecret, Mode=TwoWay}" IsEnabled="{Binding CanRememberSecret}"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="验证凭据" Command="{Binding VerifyCommand}"/>
            <TextBlock Text="{Binding VerificationDisplay}" VerticalAlignment="Center"/>
        </StackPanel>
        <Border Padding="10" BorderThickness="1" CornerRadius="6"
                BorderBrush="{DynamicResource WorkbenchGroupBorderBrush}">
            <StackPanel Spacing="8">
                <TextBlock Text="私聊接收方" FontWeight="SemiBold"/>
                <TextBlock Text="绑定时向机器人私聊当前验证码。" Opacity="0.7" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding UserOpenIdDisplay}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="绑定私聊" Command="{Binding BindUserCommand}"/>
                    <CheckBox Content="发送到私聊" IsChecked="{Binding UserEnabled, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Padding="10" BorderThickness="1" CornerRadius="6"
                BorderBrush="{DynamicResource WorkbenchGroupBorderBrush}">
            <StackPanel Spacing="8">
                <TextBlock Text="群聊接收方" FontWeight="SemiBold"/>
                <TextBlock Text="先把机器人加入目标群，再在群里 @机器人发送当前验证码。" Opacity="0.7" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding GroupOpenIdDisplay}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="绑定群聊" Command="{Binding BindGroupCommand}"/>
                    <CheckBox Content="发送到群聊" IsChecked="{Binding GroupEnabled, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <CheckBox Content="通知默认附带当前视频画面"
                  IsChecked="{Binding AttachImage, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"/>
        <Border Padding="10" Background="{DynamicResource WorkbenchOutlineAccentBackgroundBrush}" CornerRadius="6"
                IsVisible="{Binding HasBindingCode}">
            <StackPanel Spacing="4">
                <TextBlock Text="当前绑定码"/>
                <TextBlock Text="{Binding BindingCode}" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding BindingCountdownDisplay}"/>
            </StackPanel>
        </Border>
        <TextBlock Text="{Binding Feedback}" Classes.error="{Binding FeedbackIsError}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="发送图文测试" Command="{Binding SendTestCommand}"/>
            <Button Content="取消操作" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}"/>
        </StackPanel>
    </StackPanel>
</UserControl>