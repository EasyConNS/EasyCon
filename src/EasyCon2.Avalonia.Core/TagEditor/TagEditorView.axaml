<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EasyCon2.Avalonia.Core.TagEditor"
             xmlns:cvt="using:EasyCon2.Avalonia.Core.Converters"
             x:Class="EasyCon2.Avalonia.Core.TagEditor.TagEditorView"
             x:DataType="vm:TagEditorViewModel">

    <UserControl.Resources>
        <cvt:SearchMethodDescriptionConverter x:Key="SearchMethodDesc"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="NumericUpDown.coordinate-number">
            <Setter Property="Width" Value="64"/>
            <Setter Property="MinWidth" Value="64"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,0,2,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.coordinate-spin-button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="MinWidth" Value="18"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="MinHeight" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBlock.coordinate-label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchTextBrush}"/>
        </Style>

        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchTextBrush}"/>
        </Style>
    </UserControl.Styles>

    <Border BorderBrush="{DynamicResource WorkbenchControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Background="{DynamicResource WorkbenchInputBrush}"
            Padding="8">

        <Grid RowDefinitions="*,Auto" RowSpacing="12">

            <Border BorderBrush="{DynamicResource WorkbenchControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="2"
                    Background="{DynamicResource WorkbenchInputBrush}"
                    ClipToBounds="True">
                <Grid ColumnDefinitions="*,Auto">
                    <Image Source="{Binding SourceImage}"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                x:Name="PreviewActionPanel"
                                Spacing="8"
                                Margin="8"
                                VerticalAlignment="Top">
                        <Button Content="截图"
                                HorizontalAlignment="Stretch"/>
                        <Button Content="圈选范围"
                                HorizontalAlignment="Stretch"/>
                        <Button Content="圈选目标"
                                HorizontalAlignment="Stretch"/>
                        <Button Content="动态测试"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          x:Name="ParameterScroll"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Grid x:Name="ParameterLayout"
                      ColumnSpacing="14"
                      Margin="18,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="FieldsLayout"
                          RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="18">
                        <Grid x:Name="HeaderFieldsGrid"
                              ColumnSpacing="8"
                              HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="标签名称:"
                                       Classes="coordinate-label"/>
                            <TextBox Grid.Column="1"
                                     x:Name="LabelNameBox"
                                     Text="{Binding LabelName}"
                                     Height="38"
                                     MinWidth="96"
                                     HorizontalAlignment="Stretch"
                                     VerticalContentAlignment="Center"/>
                            <StackPanel Grid.Column="2"
                                        x:Name="HeaderActionPanel"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right">
                                <Button Content="保存"
                                        Command="{Binding SaveCommand}"
                                        Padding="14,4"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1"
                              x:Name="PreprocessOptionsPanel"
                              ColumnSpacing="8"
                              HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="搜索方法:"
                                       Classes="coordinate-label"/>
                            <ComboBox Grid.Column="1"
                                      x:Name="SearchMethodBox"
                                      SelectedItem="{Binding SearchMethod}"
                                      ItemsSource="{x:Static vm:TagEditorViewModel.SearchMethods}"
                                      Height="38"
                                      MinWidth="120"
                                      VerticalContentAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource SearchMethodDesc}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Column="2"
                                       Text="参数:"
                                       Classes="coordinate-label"/>
                            <ComboBox Grid.Column="3"
                                      x:Name="ParameterOptionBox"
                                      SelectedItem="{Binding SelectedParameterOption}"
                                      ItemsSource="{x:Static vm:TagEditorViewModel.ParameterOptions}"
                                      Height="38"
                                      MinWidth="90"
                                      VerticalContentAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="2"
                              x:Name="CoordinateSectionsGrid"
                              ColumnSpacing="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="TargetSection" Spacing="10">
                                <TextBlock Text="目标位置:"
                                           Classes="section-title"/>
                                <Grid x:Name="TargetCoordinateGrid"
                                      RowDefinitions="Auto,Auto"
                                      RowSpacing="10"
                                      ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="84"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="84"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="X:" Classes="coordinate-label"/>
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto">
                                        <NumericUpDown Classes="coordinate-number"
                                                       ShowButtonSpinner="False"
                                                       Value="{Binding TargetX}"
                                                       Minimum="0"
                                                       Maximum="9999"/>
                                        <StackPanel Grid.Column="1">
                                            <Button Classes="coordinate-spin-button" Content="^" Command="{Binding IncrementCoordinateCommand}" CommandParameter="TargetX"/>
                                            <Button Classes="coordinate-spin-button" Content="v" Command="{Binding DecrementCoordinateCommand}" CommandParameter="TargetX"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Column="2" Text="Y:" Classes="coordinate-label"/>
                                    <Grid Grid.Column="3" ColumnDefinitions="Auto,Auto">
                                        <NumericUpDown Classes="coordinate-number"
                                                       ShowButtonSpinner="False"
                                                       Value="{Binding TargetY}"
                                                       Minimum="0"
                                                       Maximum="9999"/>
                                        <StackPanel Grid.Column="1">
                                            <Button Classes="coordinate-spin-button" Content="^" Command="{Binding IncrementCoordinateCommand}" CommandParameter="TargetY"/>
                                            <Button Classes="coordinate-spin-button" Content="v" Command="{Binding DecrementCoordinateCommand}" CommandParameter="TargetY"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="宽:" Classes="coordinate-label"/>
                                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,Auto">
                                        <NumericUpDown Classes="coordinate-number"
                                                       ShowButtonSpinner="False"
                                                       Value="{Binding TargetWidth}"
                                                       Minimum="0"
                                                       Maximum="9999"/>
                                        <StackPanel Grid.Column="1">
                                            <Button Classes="coordinate-spin-button" Content="^" Command="{Binding IncrementCoordinateCommand}" CommandParameter="TargetWidth"/>
                                            <Button Classes="coordinate-spin-button" Content="v" Command="{Binding DecrementCoordinateCommand}" CommandParameter="TargetWidth"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="高:" Classes="coordinate-label"/>
                                    <Grid Grid.Row="1" Grid.Column="3" ColumnDefinitions="Auto,Auto">
                                        <NumericUpDown Classes="coordinate-number"
                                                       ShowButtonSpinner="False"
                                                       Value="{Binding TargetHeight}"
                                                       Minimum="0"
                                                       Maximum="9999"/>
                                        <StackPanel Grid.Column="1">
                                            <Button Classes="coordinate-spin-button" Content="^" Command="{Binding IncrementCoordinateCommand}" CommandParameter="TargetHeight"/>
                                            <Button Classes="coordinate-spin-button" Content="v" Command="{Binding DecrementCoordinateCommand}" CommandParameter="TargetHeight"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2" x:Name="RangeSection" Spacing="10">
                                <TextBlock Text="搜索范围:"
                                           Classes="section-title"/>
                                <Grid x:Name="RangeCoordinateGrid"
                                      RowDefinitions="Auto,Auto"
                                      RowSpacing="10"
                                      ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="84"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="84"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="X:" Classes="coordinate-label"/>
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto">
                                        <NumericUpDown Classes="coordinate-number"
                                                       ShowButtonSpinner="False"
                                                       Value="{Binding RangeX}"
                                                       Minimum="0"
                                                       Maximum="9999"/>
                                        <StackPanel Grid.Column="1">
                                            <Button Classes="coordinate-spin-button" Content="^" Command="{Binding IncrementCoordinateCommand}" CommandParameter="RangeX"/>
                                            <Button Classes="coordinate-spin-button" Content="v" Command="{Binding DecrementCoordinateCommand}" CommandParameter="RangeX"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Column="2" Text="Y:" Classes="coordinate-label"/>
                                    <Grid Grid.Column="3" ColumnDefinitions="Auto,Auto">
                                        <NumericUpDown Classes="coordinate-number"
                                                       ShowButtonSpinner="False"
                                                       Value="{Binding RangeY}"
                                                       Minimum="0"
                                                       Maximum="9999"/>
                                        <StackPanel Grid.Column="1">
                                            <Button Classes="coordinate-spin-button" Content="^" Command="{Binding IncrementCoordinateCommand}" CommandParameter="RangeY"/>
                                            <Button Classes="coordinate-spin-button" Content="v" Command="{Binding DecrementCoordinateCommand}" CommandParameter="RangeY"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="宽:" Classes="coordinate-label"/>
                                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,Auto">
                                        <NumericUpDown Classes="coordinate-number"
                                                       ShowButtonSpinner="False"
                                                       Value="{Binding RangeWidth}"
                                                       Minimum="0"
                                                       Maximum="9999"/>
                                        <StackPanel Grid.Column="1">
                                            <Button Classes="coordinate-spin-button" Content="^" Command="{Binding IncrementCoordinateCommand}" CommandParameter="RangeWidth"/>
                                            <Button Classes="coordinate-spin-button" Content="v" Command="{Binding DecrementCoordinateCommand}" CommandParameter="RangeWidth"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="高:" Classes="coordinate-label"/>
                                    <Grid Grid.Row="1" Grid.Column="3" ColumnDefinitions="Auto,Auto">
                                        <NumericUpDown Classes="coordinate-number"
                                                       ShowButtonSpinner="False"
                                                       Value="{Binding RangeHeight}"
                                                       Minimum="0"
                                                       Maximum="9999"/>
                                        <StackPanel Grid.Column="1">
                                            <Button Classes="coordinate-spin-button" Content="^" Command="{Binding IncrementCoordinateCommand}" CommandParameter="RangeHeight"/>
                                            <Button Classes="coordinate-spin-button" Content="v" Command="{Binding DecrementCoordinateCommand}" CommandParameter="RangeHeight"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                x:Name="PreviewPanel"
                                Spacing="12"
                                HorizontalAlignment="Center">
                        <Grid x:Name="TargetPreviewRow"
                              ColumnDefinitions="Auto,Auto"
                              ColumnSpacing="8">
                            <TextBlock x:Name="TargetPreviewLabel"
                                       Text="目&#x0a;标&#x0a;图"
                                       Classes="preview-label"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <Border BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
                                    Grid.Column="1"
                                    x:Name="TargetPreviewBox"
                                    BorderThickness="1"
                                    Width="150"
                                    Height="100"
                                    ClipToBounds="True">
                                <Image Source="{Binding TargetImage}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="MatchScoreText"
                                   Text="{Binding MatchScoreText}"
                                   Classes="match-score"
                                   HorizontalAlignment="Center"/>

                        <Grid x:Name="ResultPreviewRow"
                              ColumnDefinitions="Auto,Auto"
                              ColumnSpacing="8">
                            <TextBlock x:Name="ResultPreviewLabel"
                                       Text="结&#x0a;果&#x0a;图"
                                       Classes="preview-label"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <Border BorderBrush="{DynamicResource SystemBaseMediumLowColor}"
                                    Grid.Column="1"
                                    x:Name="ResultPreviewBox"
                                    BorderThickness="1"
                                    Width="150"
                                    Height="100"
                                    ClipToBounds="True">
                                <Image Source="{Binding RangePreviewImage}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
